<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Components.ImageViewport" x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>
        <Border x:Name="ViewportHost" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="6">
            <Grid>
                <!-- Subtle transparency checkerboard visible when viewing RGBA transparent cutouts -->
                <Rectangle IsHitTestVisible="False" Visibility="{Binding ShowTransparencyGrid, ElementName=Root, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Rectangle.Fill>
                        <DrawingBrush TileMode="Tile" Viewport="0,0,20,20" ViewportUnits="Absolute">
                            <DrawingBrush.Drawing>
                                <DrawingGroup>
                                    <GeometryDrawing Brush="#1A1A1A">
                                        <GeometryDrawing.Geometry>
                                            <RectangleGeometry Rect="0,0,20,20"/>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                    <GeometryDrawing Brush="#2B2B2B">
                                        <GeometryDrawing.Geometry>
                                            <GeometryGroup>
                                                <RectangleGeometry Rect="0,0,10,10"/>
                                                <RectangleGeometry Rect="10,10,10,10"/>
                                            </GeometryGroup>
                                        </GeometryDrawing.Geometry>
                                    </GeometryDrawing>
                                </DrawingGroup>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <ScrollViewer x:Name="Viewport" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                              PreviewMouseWheel="Viewport_PreviewMouseWheel"
                              PreviewMouseLeftButtonDown="Viewport_MouseDown"
                              PreviewMouseMove="Viewport_MouseMove"
                              PreviewMouseLeftButtonUp="Viewport_MouseUp"
                              LostMouseCapture="Viewport_LostMouseCapture"
                              Cursor="Hand">
                    <Image Source="{Binding Source, ElementName=Root}" Stretch="Uniform" Width="{Binding ActualWidth, ElementName=ViewportHost}" Height="{Binding ActualHeight, ElementName=ViewportHost}" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.LayoutTransform>
                            <ScaleTransform ScaleX="{Binding Value, ElementName=Zoom}" ScaleY="{Binding Value, ElementName=Zoom}"/>
                        </Image.LayoutTransform>
                    </Image>
                </ScrollViewer>
                <TextBlock Text="{DynamicResource Str.Lightbox.ViewportEmpty}" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Source, ElementName=Root}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="−" Click="ZoomOut_Click" Style="{StaticResource BtnGhost}" Width="28" Height="28" Padding="0" ToolTip="Zoom Out (Ctrl + Scroll)" AutomationProperties.Name="Thu nhỏ"/>
                <Slider x:Name="Zoom" Minimum="0.25" Maximum="4" Value="1" SmallChange="0.25" LargeChange="0.5" Width="130" Margin="6,0" VerticalAlignment="Center" AutomationProperties.Name="Thu phóng ảnh từ 25 đến 400 phần trăm"/>
                <Button Content="+" Click="ZoomIn_Click" Style="{StaticResource BtnGhost}" Width="28" Height="28" Padding="0" ToolTip="Zoom In (Ctrl + Scroll)" AutomationProperties.Name="Phóng to"/>
                <TextBlock Text="{Binding Value, ElementName=Zoom, Converter={StaticResource ZoomPercentConverter}}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="8,0,0,0" MinWidth="40"/>
            </StackPanel>
            <TextBlock Grid.Column="1" Text="{DynamicResource Str.Lightbox.ViewportHint}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" HorizontalAlignment="Center" Opacity="0.7" Margin="8,0"/>
            <Button Grid.Column="2" Content="{DynamicResource Str.Lightbox.FitFrame}" Click="Fit_Click" Style="{StaticResource BtnGhost}" Height="30" ToolTip="Fit (100%)" AutomationProperties.Name="Đặt ảnh vừa khung"/>
        </Grid>
    </Grid>
</UserControl>
