<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CharacterConceptAI.Desktop.Components.MaskPainterCanvas"
             x:Name="Root">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="36"/>
        </Grid.RowDefinitions>

        <Border x:Name="StageBorder"
                Background="{DynamicResource BrushCanvas}"
                BorderBrush="{DynamicResource BrushGold}"
                BorderThickness="1.2"
                CornerRadius="10"
                ClipToBounds="True"
                SizeChanged="Stage_SizeChanged"
                PreviewMouseLeftButtonDown="Stage_MouseDown"
                PreviewMouseMove="Stage_MouseMove"
                PreviewMouseLeftButtonUp="Stage_MouseUp"
                LostMouseCapture="Stage_LostMouseCapture"
                MouseLeave="Stage_MouseLeave"
                Cursor="None">
            <Grid>
                <Image x:Name="BaseImage"
                       Source="{Binding Source, ElementName=Root}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SizeChanged="Stage_SizeChanged"/>

                <!-- Translucent Volt-Lime Painted Mask Layer -->
                <Canvas x:Name="MaskLayer" IsHitTestVisible="False" Opacity="0.58"/>

                <!-- Live Brush Cursor Ring -->
                <Canvas x:Name="CursorLayer" IsHitTestVisible="False">
                    <Ellipse x:Name="BrushCursor"
                             Width="44" Height="44"
                             Stroke="{DynamicResource BrushGold}"
                             StrokeThickness="2"
                             Fill="#26B2CB25"
                             Visibility="Collapsed"/>
                </Canvas>

                <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Background="{DynamicResource BrushBadgeDark}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="1" CornerRadius="10" Padding="10,4" IsHitTestVisible="False">
                    <TextBlock Text="{DynamicResource Str.Lightbox.MaskBanner}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{DynamicResource Str.Lightbox.BrushSize}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                <Slider x:Name="BrushSlider" Minimum="12" Maximum="130" Value="{Binding BrushSize, ElementName=Root, Mode=TwoWay}" Width="120" VerticalAlignment="Center" AutomationProperties.Name="Cỡ cọ sửa ảnh"/>
                <TextBlock Text="{Binding BrushSize, ElementName=Root, StringFormat={}{0:0} px}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="6,0,12,0" MinWidth="42"/>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="{DynamicResource Str.Lightbox.Undo}" Click="Undo_Click" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="10,2" FontSize="12" Margin="0,0,6,0"/>
                <Button Content="{DynamicResource Str.Lightbox.ClearStrokes}" Click="Clear_Click" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="10,2" FontSize="12"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
