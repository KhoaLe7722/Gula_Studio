<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Features.Views.JobsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,16,0">
                <TextBlock Text="{DynamicResource Str.Jobs.Title}" Style="{StaticResource TextPageTitle}"/>
                <TextBlock Text="{DynamicResource Str.Jobs.Subtitle}" Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ComboBox ItemsSource="{Binding JobStatusFilters}" SelectedItem="{Binding JobStatusFilter}" Width="160" VerticalAlignment="Center" Margin="0,0,12,0" AutomationProperties.Name="Lọc trạng thái tác vụ">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource StatusTextConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="{DynamicResource Str.Jobs.Refresh}" Command="{Binding RefreshQueueCommand}" Style="{StaticResource BtnSecondary}" VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="1">
            <DataGrid ItemsSource="{Binding FilteredJobs}" SelectedItem="{Binding SelectedQueueJob}" IsReadOnly="True" AutoGenerateColumns="False" EnableRowVirtualization="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Hàng đợi sinh ảnh">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{DynamicResource Str.Jobs.ColId}" Binding="{Binding Id}" Width="*"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Jobs.ColStatus}" Binding="{Binding Status, Converter={StaticResource StatusTextConverter}}" Width="115"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Jobs.ColMode}" Binding="{Binding PromptMode}" Width="95"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Jobs.ColDone}" Binding="{Binding CompletedCount}" Width="90"/>
                    <DataGridTextColumn Header="{DynamicResource Str.Jobs.ColTime}" Binding="{Binding RequestedAt, StringFormat='{}{0:dd/MM HH:mm}'}" Width="130"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding GenerationQueue.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{DynamicResource Str.Jobs.EmptyTitle}" Style="{StaticResource TextSection}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="{DynamicResource Str.Jobs.EmptySub}" Style="{StaticResource TextSecondary}" Margin="0,8,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="{DynamicResource Str.Jobs.OpenStudio}" Command="{Binding SetTabCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" CommandParameter="0"/>
            </StackPanel>
        </Grid>
        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,20,0">
                    <TextBlock Text="{DynamicResource Str.Jobs.DetailTitle}" Style="{StaticResource TextSection}"/>
                    <TextBlock Text="{DynamicResource Str.Jobs.DetailHint}" Style="{StaticResource TextCaption}" Margin="0,8,0,0" Visibility="{Binding SelectedQueueJob, Converter={StaticResource NotNullToVisibilityConverter}}"/>
                    <StackPanel Visibility="{Binding SelectedQueueJob, Converter={StaticResource NullToVisibilityConverter}}">
                        <TextBlock Text="{Binding SelectedQueueJob.Id}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                        <TextBlock Text="{Binding SelectedQueueJob.ErrorSummary}" Foreground="{DynamicResource BrushWarning}" TextWrapping="Wrap" Margin="0,6,0,0" Visibility="{Binding SelectedQueueJob.ErrorSummary, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Text="{Binding SelectedQueueJob.WorkflowKey, StringFormat='{}Workflow: {0}'}" Style="{StaticResource TextCaption}" Margin="0,6,0,0"/>
                        <CheckBox Content="SIMULATED" IsChecked="{Binding SelectedQueueJob.IsSimulated, Mode=OneWay}" IsHitTestVisible="False" Focusable="False" Margin="0,8,0,0" Visibility="{Binding SelectedQueueJob.IsSimulated, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Str.Jobs.CancelSelected}" Command="{Binding CancelJobCommand}" IsEnabled="{Binding SelectedQueueJob, Converter={StaticResource NotNullToBoolConverter}}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" CommandParameter="{Binding SelectedQueueJob}"/>
                    <Border Height="8"/>
                    <Button Content="{DynamicResource Str.Jobs.RetrySelected}" Command="{Binding RetryJobCommand}" IsEnabled="{Binding SelectedQueueJob, Converter={StaticResource NotNullToBoolConverter}}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" CommandParameter="{Binding SelectedQueueJob}"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
