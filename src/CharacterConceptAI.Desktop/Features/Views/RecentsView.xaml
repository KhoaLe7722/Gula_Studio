<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Features.Views.RecentsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Đã mở gần đây" Style="{StaticResource TextPageTitle}"/>
            <TextBlock Text="Tiếp tục từ những dự án đã mở trong phiên làm việc này." Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <ListBox ItemsSource="{Binding RecentProjects}" SelectedItem="{Binding SelectedProject}" MouseDoubleClick="Projects_Open" PreviewKeyDown="Projects_KeyDown" PreviewMouseRightButtonDown="SelectContextItem" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" AutomationProperties.Name="Dự án đã mở gần đây">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="248" Margin="0,0,16,16" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushSurface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="148"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource BrushCardElevated}" CornerRadius="9,9,0,0">
                                    <Grid>
                                        <Path Data="M0,20 L20,0 40,20 20,40 Z M20,0 L20,40 M0,20 L40,20" Stroke="{DynamicResource BrushBorderStrong}" StrokeThickness="1.3" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProjectType}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="14" VerticalAlignment="Bottom"/>
                                        <Button Content="…" Click="ProjectMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource BtnSecondary}" Width="32" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" ToolTip="Thao tác với dự án" AutomationProperties.Name="Thao tác với dự án"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="16,14">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='Mới tạo'}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextMuted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RecentProjects.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="Bắt đầu một phiên sáng tạo" Style="{StaticResource TextSection}" HorizontalAlignment="Center" TextAlignment="Center"/>
                <TextBlock Text="Dự án bạn mở sẽ xuất hiện tại đây." Style="{StaticResource TextSecondary}" Margin="0,8,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                <Button Content="Xem tất cả dự án" Command="{Binding SetTabCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0" CommandParameter="6"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
