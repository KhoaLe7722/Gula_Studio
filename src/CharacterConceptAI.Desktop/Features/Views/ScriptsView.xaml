<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Features.Views.ScriptsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,24">
            <TextBlock Text="Kịch bản và phân cảnh" Style="{StaticResource TextPageTitle}"/>
            <TextBlock Text="Tổ chức câu chuyện, sắp xếp cảnh và liên kết nhân vật." Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Kịch bản" Style="{StaticResource TextSection}" Margin="4,0,0,16"/>
                    <ListBox Grid.Row="1" ItemsSource="{Binding Scripts}" SelectedItem="{Binding SelectedScript}" Background="Transparent" BorderThickness="0" AutomationProperties.Name="Danh sách kịch bản">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="8,12">
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" FontWeight="SemiBold" ToolTip="{Binding Title}"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding SceneCount, StringFormat='{}{0} cảnh'}" Style="{StaticResource TextCaption}"/>
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" Style="{StaticResource TextCaption}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Expander Grid.Row="2" Header="Tạo kịch bản" Margin="0,16,0,0">
                        <StackPanel Margin="0,12,0,0" IsEnabled="{Binding CanEditProject}">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Tên kịch bản mới" Style="{StaticResource TextBody}"/>
                                <TextBox Text="{Binding NewScriptTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên kịch bản mới"/>
                            </StackPanel>
                            <Button Content="Tạo kịch bản" Command="{Binding CreateScriptCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                        </StackPanel>
                    </Expander>
                </Grid>
            </Border>
            <TabControl x:Name="ScriptDetailsTabs" Grid.Column="2" AutomationProperties.Name="Chỉnh sửa kịch bản và cảnh">
                <TabItem Header="Kịch bản">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="4,20,16,16" IsEnabled="{Binding CanEditProject}">
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Tên kịch bản" Style="{StaticResource TextBody}"/>
                                <TextBox Text="{Binding ScriptEditorTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên kịch bản"/>
                            </StackPanel>
                            <StackPanel Margin="0,0,0,16">
                                <TextBlock Text="Tóm tắt" Style="{StaticResource TextBody}"/>
                                <TextBox Text="{Binding ScriptEditorSummary, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tóm tắt" AcceptsReturn="True" TextWrapping="Wrap" Height="180" VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>
                            <WrapPanel>
                                <Button Content="Lưu kịch bản" Command="{Binding SaveScriptCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                <Button Content="Lưu trữ kịch bản" Command="{Binding ArchiveScriptCommand}" Style="{StaticResource BtnDanger}" Margin="0,0,8,0" CommandParameter="{Binding SelectedScript}"/>
                            </WrapPanel>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Phân cảnh">
                    <Grid Margin="4,16,4,4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="180"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <DataGrid ItemsSource="{Binding Scenes}" SelectedItem="{Binding SelectedScene}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Danh sách cảnh theo thứ tự">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding OrderIndex}" Width="40"/>
                                <DataGridTextColumn Header="Phân cảnh" Binding="{Binding Title}" Width="*"/>
                                <DataGridTextColumn Header="Bối cảnh" Binding="{Binding Setting}" Width="150"/>
                            </DataGrid.Columns>
                        </DataGrid>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,16,0,0">
                            <StackPanel>
                                <WrapPanel Margin="0,0,0,20">
                                    <Button Content="Di chuyển lên" Command="{Binding MoveSceneUpCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" CommandParameter="{Binding SelectedScene}"/>
                                    <Button Content="Di chuyển xuống" Command="{Binding MoveSceneDownCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" CommandParameter="{Binding SelectedScene}"/>
                                </WrapPanel>
                                <StackPanel IsEnabled="{Binding CanEditProject}">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Tiêu đề cảnh" Style="{StaticResource TextBody}"/>
                                        <TextBox Text="{Binding SceneEditorTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tiêu đề cảnh"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Bối cảnh" Style="{StaticResource TextBody}"/>
                                        <TextBox Text="{Binding SceneEditorSetting, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bối cảnh"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Nội dung" Style="{StaticResource TextBody}"/>
                                        <TextBox Text="{Binding SceneEditorContent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nội dung" AcceptsReturn="True" TextWrapping="Wrap" Height="160" VerticalScrollBarVisibility="Auto"/>
                                    </StackPanel>
                                    <Button Content="Lưu phân cảnh" Command="{Binding SaveSceneCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                </StackPanel>
                                <Expander Header="Nhân vật xuất hiện trong cảnh" Margin="0,20,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <ItemsControl ItemsSource="{Binding SceneCharacterLinks}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox Content="{Binding Name}" IsChecked="{Binding IsLinked}" Margin="0,0,0,12" IsEnabled="{Binding DataContext.CanEditProject, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <Button Content="Lưu liên kết nhân vật" Command="{Binding SaveSceneLinksCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                                    </StackPanel>
                                </Expander>
                                <Expander Header="Tạo phân cảnh mới" Margin="0,20,0,0">
                                    <StackPanel Margin="0,16,0,0" IsEnabled="{Binding CanEditProject}">
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Tiêu đề cảnh mới" Style="{StaticResource TextBody}"/>
                                            <TextBox Text="{Binding NewSceneTitle, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tiêu đề cảnh mới"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Bối cảnh mới" Style="{StaticResource TextBody}"/>
                                            <TextBox Text="{Binding NewSceneSetting, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Bối cảnh mới"/>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,0,16">
                                            <TextBlock Text="Nội dung mới" Style="{StaticResource TextBody}"/>
                                            <TextBox Text="{Binding NewSceneContent, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nội dung mới" AcceptsReturn="True" TextWrapping="Wrap" Height="100" VerticalScrollBarVisibility="Auto"/>
                                        </StackPanel>
                                        <Button Content="Thêm phân cảnh" Command="{Binding CreateSceneCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</UserControl>
