<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:CharacterConceptAI.Desktop.Components"
             x:Class="CharacterConceptAI.Desktop.Features.Views.StoryStudioView">
    <UserControl.Resources>
        <Style x:Key="StoryPillCta" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushEmerald}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnEmerald}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BrushEmeraldHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BrushEmeraldPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ROW 0: STORY STUDIO HEADER BAR -->
        <Border Grid.Row="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="16,12" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{DynamicResource BrushEmerald}" CornerRadius="10" Width="34" Height="34" Margin="0,0,10,0">
                            <Path Data="{StaticResource Icon.BookOpen}" Style="{StaticResource LucideIcon}" Stroke="{DynamicResource BrushOnEmerald}"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{DynamicResource Str.Story.Title}" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}"/>
                            <TextBlock Text="{DynamicResource Str.Story.Subtitle}" Style="{StaticResource TextCaption}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding StoryReaderButtonLabel}" Command="{Binding ToggleStoryReaderModeCommand}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4" Margin="0,0,8,0"/>
                        <Button Command="{Binding ExportStoryImagesCommand}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.FolderOpen}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Str.Story.Export}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding GenerateAllStoryScenesCommand}" Style="{StaticResource StoryPillCta}" Height="34" Padding="16,0" Visibility="{Binding IsStoryBatchGenerating, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Str.Story.RenderAll}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding CancelStoryBatchCommand}" Style="{StaticResource BtnSecondary}" Foreground="{DynamicResource BrushNegative}" Height="34" Padding="14,0" Visibility="{Binding IsStoryBatchGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Square}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushNegative}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Str.Story.StopBatch}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Row 2: Story Selector + Title + Style + Aspect Ratio (Clean generous widths, zero truncation) -->
                <WrapPanel Margin="0,10,0,0" VerticalAlignment="Center">
                    <ComboBox ItemsSource="{Binding Stories}" SelectedItem="{Binding ActiveStory}" DisplayMemberPath="Title" Width="216" MinHeight="34" Margin="0,2,8,2" ToolTip="Story"/>
                    <TextBox Text="{Binding ActiveStory.Title, UpdateSourceTrigger=PropertyChanged}" Width="216" MinHeight="34" Margin="0,2,8,2" ToolTip="Story Title" LostFocus="StoryField_LostFocus"/>
                    <Button Command="{Binding CreateNewStoryCommand}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="11,2" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,4,2">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource LucideIconSmall}" Margin="0,0,5,0"/>
                            <TextBlock Text="{DynamicResource Str.Story.NewStory}" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Content="{DynamicResource Str.Common.Delete}" Command="{Binding DeleteActiveStoryCommand}" Style="{StaticResource BtnGhost}" MinHeight="34" Padding="9,2" FontSize="{DynamicResource FontSizeSmall}" Margin="0,2,14,2"/>

                    <TextBlock Text="{DynamicResource Str.Story.StyleColon}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,2,6,2"/>
                    <ComboBox ItemsSource="{Binding AvailableStylePresets}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding ActiveStory.StylePresetKey}" Width="154" MinHeight="34" Margin="0,2,14,2" SelectionChanged="StoryCombo_Changed"/>

                    <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="4,2" Margin="0,2,0,2">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="3:4" Command="{Binding SetStoryAspectRatioCommand}" CommandParameter="3:4" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveStory.AspectRatioKey, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=3:4}" MinHeight="28" Padding="8,2" FontSize="{DynamicResource FontSizeSmall}"/>
                            <Button Content="1:1" Command="{Binding SetStoryAspectRatioCommand}" CommandParameter="1:1" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveStory.AspectRatioKey, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=1:1}" MinHeight="28" Padding="8,2" FontSize="{DynamicResource FontSizeSmall}"/>
                            <Button Content="2:3" Command="{Binding SetStoryAspectRatioCommand}" CommandParameter="2:3" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveStory.AspectRatioKey, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=2:3}" MinHeight="28" Padding="8,2" FontSize="{DynamicResource FontSizeSmall}"/>
                            <Button Content="16:9" Command="{Binding SetStoryAspectRatioCommand}" CommandParameter="16:9" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveStory.AspectRatioKey, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=16:9}" MinHeight="28" Padding="8,2" FontSize="{DynamicResource FontSizeSmall}"/>
                            <Button Content="{DynamicResource Str.Studio.Fast}" Command="{Binding SetStoryAspectRatioCommand}" CommandParameter="512" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveStory.AspectRatioKey, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=512}" MinHeight="28" Padding="8,2" FontSize="{DynamicResource FontSizeSmall}"/>
                            <Border Background="{DynamicResource BrushSelected}" CornerRadius="10" Padding="8,2" Margin="4,0,2,0" VerticalAlignment="Center">
                                <TextBlock Text="{Binding ActiveStory.ResolutionLabel}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSelected}"/>
                            </Border>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- ROW 1A: EDITOR WORKSPACE -->
        <Grid Grid.Row="1" Visibility="{Binding IsStoryReaderMode, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="424"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT COLUMN: DÀN NHÂN VẬT CỐ ĐỊNH (Smooth Pill Selector + Spacious Non-Overlapping Profile Editor) -->
            <Border Grid.Column="0" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="14">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="{DynamicResource Str.Story.CastHeader}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold"/>
                            <TextBlock Text="{DynamicResource Str.Story.CastSub}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2" Content="{DynamicResource Str.Story.Add}" Command="{Binding AddStoryCharacterCommand}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="12,2" FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center"/>
                    </Grid>

                    <!-- Smooth WrapPanel Character Chip Selector (Replaces jumpy CanContentScroll ListBox!) -->
                    <ScrollViewer DockPanel.Dock="Top"
                                  MaxHeight="138"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  Margin="0,0,0,10"
                                  Padding="0,0,4,0">
                        <ItemsControl ItemsSource="{Binding ActiveStoryCharacters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectStoryCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BtnPillToggle}"
                                            Padding="7,5,10,5"
                                            MinHeight="40"
                                            Margin="0,0,6,6"
                                            ToolTip="{Binding FaceLockBadge}">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                <Binding Path="Id"/>
                                                <Binding Path="DataContext.SelectedStoryCharacterId" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Tag>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="28" Height="28" CornerRadius="14" ClipToBounds="True" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" Margin="0,0,8,0">
                                                <Grid>
                                                    <Path Data="{StaticResource Icon.User}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.8" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding HasFaceAnchor, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    <Image Source="{Binding FacePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSmall}" MaxWidth="136" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding FaceCountBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}" Visibility="{Binding HasFaceAnchor, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,0,0,10"/>

                    <!-- Selected Character DNA & Face Identity Anchor Editor (Zero Overlapping Labels!) -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,6,0" Visibility="{Binding HasSelectedStoryCharacter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel>
                            <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="12" Padding="12" Margin="0,0,0,12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="98"/>
                                            <ColumnDefinition Width="12"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <Button Command="{Binding OpenStoryCharacterFaceLightboxCommand}"
                                                CommandParameter="{Binding SelectedStoryCharacter}"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Padding="0"
                                                Cursor="Hand"
                                                ToolTip="Nhấn để phóng to xem ảnh nhân vật 1:1">
                                            <Border Width="98" Height="124" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                                                <Grid>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="6" Visibility="{Binding SelectedStoryCharacter.HasFaceAnchor, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <Path Data="{StaticResource Icon.User}" Width="26" Height="26" Stretch="Uniform" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.7" HorizontalAlignment="Center"/>
                                                        <TextBlock Text="{DynamicResource Str.Story.NoFaceYet}" FontSize="10.5" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextMuted}" Margin="0,6,0,0"/>
                                                    </StackPanel>
                                                    <Image Source="{Binding SelectedStoryCharacter.FacePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="4" Background="{DynamicResource BrushBadgeDark}" CornerRadius="7" Padding="6,2" Visibility="{Binding SelectedStoryCharacter.HasFaceAnchor, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{DynamicResource Str.Story.View1x1}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                    </Border>
                                                    <Border Background="{DynamicResource BrushBadgeDark}" Visibility="{Binding SelectedStoryCharacter.IsGeneratingPortrait, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{Binding SelectedStoryCharacter.PortraitProgressLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}" TextWrapping="Wrap" TextAlignment="Center" Margin="6" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>

                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Str.Story.FacePackTitle}" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Border Grid.Column="1" Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="0.8" CornerRadius="8" Padding="6,2" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding SelectedStoryCharacter.FaceCountBadge}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSelected}"/>
                                                </Border>
                                            </Grid>
                                            <TextBlock Text="{Binding SelectedStoryCharacter.FacePackSummary}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,3,0,8"/>
                                            <Button Command="{Binding BrowseStoryCharacterFaceCommand}" CommandParameter="{Binding SelectedStoryCharacter}" Style="{StaticResource BtnSecondary}" MinHeight="30" Padding="8,2" FontSize="12" Margin="0,0,0,5">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.Image}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Str.Story.UploadPrimary}" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                            <Button Command="{Binding GenerateStoryCharacterPortraitCommand}" CommandParameter="{Binding SelectedStoryCharacter}" Style="{StaticResource StoryPillCta}" Height="30" Padding="8,0" FontSize="12">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,5,0"/>
                                                    <TextBlock Text="{DynamicResource Str.Story.AutoDrawFace}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Multi-Angle & Expression Face Pack -->
                                    <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Margin="0,10,0,0" Padding="0,10,0,0">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Button Grid.Column="0"
                                                        Content="{DynamicResource Str.Story.AddFaceAngle}"
                                                        Command="{Binding AddStoryCharacterExtraFacesCommand}"
                                                        CommandParameter="{Binding SelectedStoryCharacter}"
                                                        IsEnabled="{Binding SelectedStoryCharacter.CanAddExtraFace}"
                                                        Style="{StaticResource BtnSecondary}"
                                                        MinHeight="30"
                                                        Padding="6,2"
                                                        FontSize="11.5"/>
                                                <Button Grid.Column="2"
                                                        Command="{Binding GenerateStoryCharacterThreeAnglePackCommand}"
                                                        CommandParameter="{Binding SelectedStoryCharacter}"
                                                        IsEnabled="{Binding SelectedStoryCharacter.CanAddExtraFace}"
                                                        Style="{StaticResource StoryPillCta}"
                                                        Height="30"
                                                        Padding="6,0"
                                                        FontSize="11.5">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.Sparkles}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource BrushOnEmerald}" StrokeThickness="1.9" Margin="0,0,5,0"/>
                                                        <TextBlock Text="{DynamicResource Str.Story.ThreeAnglePack}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>

                                            <TextBlock Text="{DynamicResource Str.Story.ExtraFacesHint}"
                                                       Style="{StaticResource TextCaption}"
                                                       FontSize="11"
                                                       TextWrapping="Wrap"
                                                       Visibility="{Binding SelectedStoryCharacter.HasExtraFaces, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>

                                            <ItemsControl ItemsSource="{Binding SelectedStoryCharacter.ExtraFaces}"
                                                          Visibility="{Binding SelectedStoryCharacter.HasExtraFaces, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="70" Margin="0,2,6,4">
                                                            <Grid Width="70" Height="82">
                                                                <Button Command="{Binding DataContext.OpenStoryExtraFaceLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        BorderThickness="0"
                                                                        Padding="0"
                                                                        Cursor="Hand"
                                                                        ToolTip="Nhấn để phóng to 1:1 ảnh góc mặt này">
                                                                    <Border Width="70" Height="82" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                                                                        <Image Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    </Border>
                                                                </Button>
                                                                <Button Command="{Binding DataContext.RemoveStoryCharacterExtraFaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                        CommandParameter="{Binding}"
                                                                        Style="{StaticResource BtnCloseIconCompact}"
                                                                        Width="20" Height="20" MinHeight="20"
                                                                        Background="{DynamicResource BrushBadgeDark}"
                                                                        Foreground="{DynamicResource BrushOnBadgeDark}"
                                                                        HorizontalAlignment="Right"
                                                                        VerticalAlignment="Top"
                                                                        Margin="2"
                                                                        ToolTip="Gỡ góc mặt này"/>
                                                            </Grid>
                                                            <TextBlock Text="{Binding AngleLabel}" FontSize="10" Foreground="{DynamicResource BrushTextMuted}" TextTrimming="CharacterEllipsis" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <TextBlock Text="{DynamicResource Str.Story.CharName}" Style="{StaticResource TextCaption}" FontWeight="Bold" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedStoryCharacter.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,10" LostFocus="StoryField_LostFocus"/>

                            <TextBlock Text="{DynamicResource Str.Story.VisualDnaLabel}" Style="{StaticResource TextCaption}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,0,4"/>
                            <TextBox Text="{Binding SelectedStoryCharacter.VisualDna, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="10,8"
                                     MinHeight="84"
                                     MaxHeight="140"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,10"
                                     PreviewMouseWheel="StoryMultiLineTextBox_PreviewMouseWheel"
                                     LostFocus="StoryField_LostFocus"/>

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{DynamicResource Str.Story.BodyDnaLabel}" Style="{StaticResource TextCaption}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <CheckBox Grid.Column="1" Content="{DynamicResource Str.Story.Sync}" IsChecked="{Binding SelectedStoryCharacter.EnableBodyDnaLock}" FontSize="{DynamicResource FontSizeCaption}" MinHeight="26" VerticalAlignment="Center" Click="StoryCheck_Changed"/>
                            </Grid>
                            <TextBox Text="{Binding SelectedStoryCharacter.BodyDna, UpdateSourceTrigger=PropertyChanged}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     VerticalContentAlignment="Top"
                                     Padding="10,8"
                                     MinHeight="72"
                                     MaxHeight="124"
                                     VerticalScrollBarVisibility="Auto"
                                     Margin="0,0,0,12"
                                     PreviewMouseWheel="StoryMultiLineTextBox_PreviewMouseWheel"
                                     LostFocus="StoryField_LostFocus"/>

                            <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12,10" Margin="0,0,0,12">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding SelectedStoryCharacter.EnableFaceLock}" FontWeight="SemiBold" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,10" Click="StoryCheck_Changed">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Margin="0,0,6,0"/>
                                            <TextBlock Text="{DynamicResource Str.Story.EnableFaceLock}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </CheckBox>
                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str.Story.FaceSimilarity}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStoryCharacter.FaceStrengthPercent}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushGold}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider Minimum="0.2" Maximum="1.0" SmallChange="0.05" Value="{Binding SelectedStoryCharacter.FaceSwapStrength}" Margin="0,0,0,10" LostFocus="StoryField_LostFocus"/>

                                    <Grid Margin="0,0,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{DynamicResource Str.Story.FaceRestoreLabel}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding SelectedStoryCharacter.RestoreStrengthPercent}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushPositive}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.05" Value="{Binding SelectedStoryCharacter.FaceRestoreStrength}" LostFocus="StoryField_LostFocus"/>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Command="{Binding UseStoryCharacterInStudioCommand}" CommandParameter="{Binding SelectedStoryCharacter}" Style="{StaticResource StoryPillCta}" Height="32" Padding="10,0" FontSize="12">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{DynamicResource Str.Story.UseInAiStudio}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Content="{DynamicResource Str.Common.Delete}" Command="{Binding DeleteStoryCharacterCommand}" CommandParameter="{Binding SelectedStoryCharacter}" Style="{StaticResource BtnGhost}" Foreground="{DynamicResource BrushNegative}" MinHeight="32" Padding="10,2" FontSize="12"/>
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- RIGHT COLUMN: MULTI-SCENE STORYBOARD TIMELINE -->
            <DockPanel Grid.Column="2">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="{DynamicResource Str.Story.ScenesHeader}" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Margin="0,0,10,0"/>
                        <Border Background="{DynamicResource BrushSelected}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="0.8" CornerRadius="10" Padding="10,3" VerticalAlignment="Center">
                            <TextBlock Text="{Binding ActiveStory.SummaryLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSelected}"/>
                        </Border>
                    </StackPanel>
                    <Button Command="{Binding AddStorySceneCommand}" Style="{StaticResource StoryPillCta}" Height="34" Padding="16,0" HorizontalAlignment="Right">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Plus}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                            <TextBlock Text="{DynamicResource Str.Story.AddScene}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding ActiveStoryScenes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="14" Margin="0,0,0,14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="244"/>
                                            <ColumnDefinition Width="16"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>

                                        <!-- Scene Visual Preview -->
                                        <StackPanel Grid.Column="0">
                                            <Button Command="{Binding DataContext.OpenStorySceneLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                <Border Height="276" Width="244" CornerRadius="12" ClipToBounds="True" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1">
                                                    <Grid>
                                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="14" Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding SceneNumberLabel}" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" Foreground="{DynamicResource BrushTextMuted}"/>
                                                            <TextBlock Text="{DynamicResource Str.Story.SceneEmptyHint}" Style="{StaticResource TextCaption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                                        </StackPanel>
                                                        <Image Source="{Binding DisplayImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Background="{DynamicResource BrushBadgeEmerald}" BorderBrush="#000000" BorderThickness="0.8" CornerRadius="9" Padding="8,3">
                                                            <TextBlock Text="{Binding SceneNumberLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                        </Border>
                                                        <Border Background="{DynamicResource BrushBadgeDark}" Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                                                <TextBlock Text="{DynamicResource Str.Story.RenderingScene}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}" HorizontalAlignment="Center"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="11.5" Foreground="{DynamicResource BrushOnBadgeDark}" Opacity="0.85" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource TextCaption}" Margin="2,6,2,6" TextTrimming="CharacterEllipsis"/>
                                            <WrapPanel Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Button Content="{DynamicResource Str.Story.View1to1}" Command="{Binding DataContext.OpenStorySceneLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="28" Padding="9,2" FontSize="11.5" Margin="0,0,5,4"/>
                                                <Button Content="{DynamicResource Str.Story.Upscale2x}" Command="{Binding DataContext.UpscaleStorySceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="28" Padding="9,2" FontSize="11.5" Margin="0,0,5,4" Visibility="{Binding CanUpscale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Command="{Binding DataContext.UseSceneImageAsCharacterFaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="8,2" FontSize="11.5" Margin="0,0,4,4" ToolTip="{DynamicResource Str.Story.SetAnchor}">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.Lock}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource BrushGold}" StrokeThickness="1.9" Margin="0,0,4,0"/>
                                                        <TextBlock Text="{DynamicResource Str.Story.SetAnchor}" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Button Content="{DynamicResource Str.Story.AddAngle}" Command="{Binding DataContext.AddSceneImageAsExtraFaceCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="8,2" FontSize="11.5" Margin="0,0,0,4" ToolTip="{DynamicResource Str.Story.AddAngle}"/>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- Scene Controls -->
                                        <StackPanel Grid.Column="2">
                                            <Grid Margin="0,0,0,8">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="138"/>
                                                    <ColumnDefinition Width="6"/>
                                                    <ColumnDefinition Width="148"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" FontWeight="SemiBold" MinHeight="34" ToolTip="Tên cảnh" LostFocus="StoryField_LostFocus"/>
                                                <ComboBox Grid.Column="2"
                                                          ItemsSource="{Binding DataContext.ActiveStoryCharacters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                          SelectedValuePath="Id"
                                                          DisplayMemberPath="Name"
                                                          SelectedValue="{Binding CharacterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          MinHeight="34"
                                                          ToolTip="Nhân vật chính (Trái)"
                                                          SelectionChanged="StoryCombo_Changed"/>
                                                <Grid Grid.Column="4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <ComboBox ItemsSource="{Binding DataContext.ActiveStoryCharacters, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                              SelectedValuePath="Id"
                                                              DisplayMemberPath="Name"
                                                              SelectedValue="{Binding SecondaryCharacterId, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              MinHeight="34"
                                                              ToolTip="Nhân vật 2 (Phải · Khóa cặp đôi 2 mặt trong cùng cảnh)"
                                                              SelectionChanged="StoryCombo_Changed"/>
                                                    <Border Background="{DynamicResource BrushCard}" Margin="5,4,26,4" Padding="4,0" VerticalAlignment="Stretch" IsHitTestVisible="False" Visibility="{Binding HasSecondaryCharacter, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                                        <TextBlock Text="{DynamicResource Str.Story.SecondChar}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                                    </Border>
                                                    <Button Grid.Column="1" Command="{Binding DataContext.ClearSceneSecondaryCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnCloseIconCompact}" Margin="2,0,0,0" Visibility="{Binding HasSecondaryCharacter, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Bỏ nhân vật 2"/>
                                                </Grid>
                                                <StackPanel Grid.Column="5" Orientation="Horizontal" Margin="6,0,0,0" VerticalAlignment="Center">
                                                    <Button Command="{Binding DataContext.MoveStorySceneUpCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" Width="28" MinHeight="28" Padding="0" ToolTip="Đẩy lên">
                                                        <Path Data="{StaticResource Icon.ChevronUp}" Style="{StaticResource LucideIconSmall}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.MoveStorySceneDownCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" Width="28" MinHeight="28" Padding="0" ToolTip="Đẩy xuống">
                                                        <Path Data="{StaticResource Icon.ChevronDown}" Style="{StaticResource LucideIconSmall}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DuplicateStorySceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" Width="28" MinHeight="28" Padding="0" ToolTip="Nhân bản cảnh">
                                                        <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource LucideIconSmall}"/>
                                                    </Button>
                                                    <Button Command="{Binding DataContext.DeleteStorySceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnCloseIconCompact}" Margin="2,0,0,0" ToolTip="Xóa cảnh" AutomationProperties.Name="Xóa cảnh"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="8"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{DynamicResource Str.Story.SceneActionLabel}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <Button Grid.Column="2" Command="{Binding DataContext.EnhanceStoryScenePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" MinHeight="26" Padding="8,2" FontSize="11.5" ToolTip="{DynamicResource Str.Story.EnhanceScene}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource BtnGhost}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsEnhancing}" Value="True">
                                                                    <Setter Property="IsEnabled" Value="False"/>
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.Wand}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource BrushGold}" StrokeThickness="1.9" Margin="0,0,5,0"/>
                                                        <TextBlock FontSize="11.5" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Text" Value="{DynamicResource Str.Story.EnhanceScene}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsEnhancing}" Value="True">
                                                                            <Setter Property="Text" Value="{DynamicResource Str.Story.EnhancingScene}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                            <TextBox Text="{Binding ScenePrompt, UpdateSourceTrigger=PropertyChanged}"
                                                     TextWrapping="Wrap"
                                                     AcceptsReturn="True"
                                                     VerticalContentAlignment="Top"
                                                     Padding="10,8"
                                                     MinHeight="70"
                                                     MaxHeight="116"
                                                     VerticalScrollBarVisibility="Auto"
                                                     Margin="0,0,0,8"
                                                     PreviewMouseWheel="StoryMultiLineTextBox_PreviewMouseWheel"
                                                     LostFocus="StoryField_LostFocus"/>

                                            <TextBlock Text="{DynamicResource Str.Story.DialogueLabel}" Style="{StaticResource TextCaption}" Margin="0,0,0,4"/>
                                            <TextBox Text="{Binding Dialogue, UpdateSourceTrigger=PropertyChanged}" MinHeight="32" Margin="0,0,0,10" LostFocus="StoryField_LostFocus"/>

                                            <!-- Depth Pose & Camera Angle Strip -->
                                            <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="42" Height="52" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}" Margin="0,0,10,0" Visibility="{Binding HasDepthPose, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image Source="{Binding DepthPoseThumb}" Stretch="Uniform"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Str.Story.PoseSectionTitle}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource Str.Story.NoPoseSelected}" Style="{StaticResource TextCaption}" Visibility="{Binding HasDepthPose, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                        <Grid Margin="0,3,0,0" Visibility="{Binding HasDepthPose, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="{Binding DepthPoseLabel}" FontSize="12" Foreground="{DynamicResource BrushGold}" VerticalAlignment="Center" Margin="0,0,10,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DepthPoseLabel}"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding DepthStrengthLabel}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                            <Slider Grid.Column="2" Minimum="0.50" Maximum="1.15" SmallChange="0.05" Value="{Binding DepthStrength}" Width="92" VerticalAlignment="Center" LostFocus="StoryField_LostFocus"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Button Command="{Binding DataContext.OpenPoseGalleryForSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="12,3" FontSize="12">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource Icon.Pose}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{DynamicResource Str.Story.PickPose}" FontSize="12" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.ClearScenePoseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnCloseIconCompact}" Margin="6,0,0,0" Visibility="{Binding HasDepthPose, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <!-- Scene Outfit Picker Bar -->
                                            <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Border Width="38" Height="52" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}" Margin="0,0,10,0" Visibility="{Binding HasOutfit, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                        <Image Source="{Binding OutfitThumb}" Stretch="Uniform"/>
                                                    </Border>

                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{DynamicResource Str.Story.OutfitSectionTitle}" FontSize="12" FontWeight="SemiBold"/>
                                                        <TextBlock Text="{DynamicResource Str.Story.NoOutfitSelected}" Style="{StaticResource TextCaption}" Visibility="{Binding HasOutfit, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                        <TextBlock Text="{Binding OutfitLabel}" FontSize="12" Foreground="{DynamicResource BrushGold}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" Visibility="{Binding HasOutfit, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="{Binding OutfitLabel}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                                        <Button Command="{Binding DataContext.OpenOutfitGalleryForSceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="12,3" FontSize="12">
                                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                <Path Data="{StaticResource Icon.Shirt}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                                                <TextBlock Text="{DynamicResource Str.Story.PickOutfit}" FontSize="12" VerticalAlignment="Center"/>
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Command="{Binding DataContext.ClearSceneOutfitCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnCloseIconCompact}" Margin="6,0,0,0" Visibility="{Binding HasOutfit, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushNegative}" FontSize="12" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0" Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Command="{Binding DataContext.GenerateStorySceneCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource StoryPillCta}" Height="36" MinWidth="136" Padding="18,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                                                            <TextBlock Text="{DynamicResource Str.Story.RenderScene}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <!-- ROW 1B: STORY READER MODE -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding IsStoryReaderMode, Converter={StaticResource BooleanToVisibilityConverter}}">
            <StackPanel MaxWidth="920" HorizontalAlignment="Center" Margin="16,4,16,32">
                <TextBlock Text="{Binding ActiveStory.Title}" FontSize="{DynamicResource FontSizePage}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,6"/>
                <TextBlock Text="{Binding ActiveStory.SummaryLabel}" Style="{StaticResource TextCaption}" HorizontalAlignment="Center" Margin="0,0,0,24"/>

                <ItemsControl ItemsSource="{Binding ActiveStoryScenes}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="18" Padding="18" Margin="0,0,0,22">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" TextWrapping="Wrap" Margin="0,0,12,0"/>
                                        <TextBlock Grid.Column="1" Text="{Binding DepthPoseLabel}" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Border CornerRadius="14" ClipToBounds="True" Background="{DynamicResource BrushCanvas}" MaxHeight="660" Visibility="{Binding HasImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Image Source="{Binding DisplayImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Border Background="{DynamicResource BrushCanvas}" CornerRadius="12" Padding="24" Visibility="{Binding HasImage, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                                        <TextBlock Text="Cảnh này chưa được vẽ — quay lại chế độ chỉnh sửa để vẽ cảnh." Style="{StaticResource TextSecondary}" HorizontalAlignment="Center"/>
                                    </Border>
                                    <Border Background="{DynamicResource BrushChatUserBubble}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,14,0,0" Visibility="{Binding HasDialogue, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="{Binding Dialogue}" FontSize="{DynamicResource FontSizeSubtitle}" TextWrapping="Wrap" Foreground="{DynamicResource BrushTextPrimary}"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- IN-TAB 1:1 LIGHTBOX OVERLAY -->
        <Grid Grid.RowSpan="2" Panel.ZIndex="25" Background="{DynamicResource BrushOverlay}" MouseLeftButtonDown="StoryLightboxBackdrop_MouseDown" Visibility="{Binding IsStoryLightboxOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource BrushBorderStrong}" CornerRadius="20" Margin="24" Padding="18">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding StoryLightboxTitle}" Style="{StaticResource TextSection}" Margin="0,0,12,0" MaxWidth="420" TextTrimming="CharacterEllipsis" ToolTip="{Binding StoryLightboxTitle}"/>
                            <TextBlock Grid.Column="1" Text="{Binding StoryLightboxSubtitle}" Style="{StaticResource TextCaption}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding StoryLightboxSubtitle}"/>
                        </Grid>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding SaveStoryLightboxImageCommand}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="12,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Download}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                    <TextBlock Text="Tải về PNG" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CopyStoryLightboxImageCommand}" Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4" Margin="0,0,8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource LucideIconSmall}" Margin="0,0,5,0"/>
                                    <TextBlock Text="Sao chép" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding CloseStoryLightboxCommand}" Style="{StaticResource BtnCloseIcon}" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng (Esc)"/>
                        </StackPanel>
                    </Grid>
                    <components:ImageViewport Source="{Binding StoryLightboxImage}" MinHeight="360"/>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
