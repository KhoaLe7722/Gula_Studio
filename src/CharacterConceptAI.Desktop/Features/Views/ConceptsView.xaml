<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:components="clr-namespace:CharacterConceptAI.Desktop.Components" x:Class="CharacterConceptAI.Desktop.Features.Views.ConceptsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,20">
            <TextBlock Text="Thư viện concept" Style="{StaticResource TextPageTitle}"/>
            <TextBlock Text="Xem toàn dự án hoặc lọc nhân vật; chọn đúng phiên bản khi duyệt." Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            <WrapPanel Margin="0,20,0,0">
                <ComboBox Width="220" ItemsSource="{Binding Characters}" SelectedItem="{Binding SelectedCharacter}" DisplayMemberPath="Name" AutomationProperties.Name="Lọc concept theo nhân vật" Margin="0,0,12,0"/>
                <Button Content="Toàn dự án" Command="{Binding ClearCharacterFilterCommand}" Style="{StaticResource BtnGhost}" Margin="0,0,16,0"/>
                <ComboBox Width="160" ItemsSource="{Binding ConceptStatusFilters}" SelectedItem="{Binding ConceptStatusFilter}" AutomationProperties.Name="Lọc trạng thái phê duyệt concept" Margin="0,0,12,0"/>
                <Button Content="Làm mới" Command="{Binding RefreshConceptsCommand}" Style="{StaticResource BtnSecondary}"/>
            </WrapPanel>
        </StackPanel>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="248"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <ListBox ItemsSource="{Binding CharacterConcepts}" SelectedItem="{Binding SelectedConcept}" Background="Transparent" BorderThickness="0" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Các concept thuộc phạm vi đang lọc">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="14,16">
                                    <Border Background="{DynamicResource BrushCardElevated}" Height="108" CornerRadius="6" Margin="0,0,0,12" ClipToBounds="True">
                                        <Grid>
                                            <TextBlock Text="CONCEPT" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image.Source>
                                                    <MultiBinding Converter="{StaticResource AssetThumbnailConverter}">
                                                        <Binding Path="RepresentativeAssetId"/>
                                                        <Binding Path="DataContext.ConceptThumbnailsVersion" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                        <Binding Path="DataContext" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Image.Source>
                                            </Image>
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"/>
                                    <Grid Margin="0,6,0,0">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12" Foreground="{DynamicResource BrushTextSecondary}"/>
                                        <TextBlock Text="{Binding VersionCount, StringFormat='{}{0} phiên bản'}" FontSize="11" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding CharacterConcepts.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="Chưa có concept" Style="{StaticResource TextSection}" HorizontalAlignment="Center" TextAlignment="Center"/>
                        <TextBlock Text="Thử đổi bộ lọc hoặc tạo concept trong Studio AI." Style="{StaticResource TextSecondary}" Margin="0,8,0,20" TextWrapping="Wrap" TextAlignment="Center"/>
                    </StackPanel>
                </Grid>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="{Binding SelectedConcept.Title, TargetNullValue='Chọn một concept'}" Style="{StaticResource TextSection}"/>
                        <TextBlock Text="{Binding SelectedConcept.Description}" Style="{StaticResource TextCaption}" TextTrimming="CharacterEllipsis" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
                <TabControl Grid.Row="1" AutomationProperties.Name="Ảnh phiên bản so sánh và duyệt concept">
                    <TabItem Header="Phiên bản">
                        <Grid Margin="4,16,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,16">
                                <TextBlock Text="Phiên bản" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <ComboBox Width="112" ItemsSource="{Binding ConceptVersions}" SelectedItem="{Binding SelectedVersion}" DisplayMemberPath="VersionNumber" AutomationProperties.Name="Chọn phiên bản concept" Margin="0,0,12,0"/>
                                <Button Content="Lưu ảnh" Command="{Binding SaveConceptImageCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                                <Button Content="Sao chép ảnh" Command="{Binding CopyConceptImageCommand}" Style="{StaticResource BtnGhost}" Margin="0,0,8,0"/>
                            </WrapPanel>
                            <components:ImageViewport Grid.Row="1" Source="{Binding ConceptVersionImage}" AutomationProperties.Name="Ảnh phiên bản concept đang chọn"/>
                            <StackPanel Grid.Row="2" Margin="0,12,0,0">
                                <WrapPanel>
                                    <Button Content="Đặt làm đại diện" Command="{Binding SetRepresentativeVersionCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                                    <Button Content="Gửi phiên bản đi duyệt" Command="{Binding SubmitConceptForReviewCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                    <Button Content="Dùng làm tham chiếu" Command="{Binding UseVersionAsReferenceCommand}" CommandParameter="{Binding SelectedVersion}" Style="{StaticResource BtnGhost}" IsEnabled="{Binding IsImg2ImgAvailable}" ToolTip="{Binding Img2ImgAvailabilityReason}" ToolTipService.ShowOnDisabled="True"/>
                                </WrapPanel>
                                <Expander Header="Nguồn gốc và prompt của phiên bản" Margin="0,12,0,0">
                                    <StackPanel Margin="0,12,0,0">
                                        <TextBlock Text="{Binding SelectedVersion.Id, StringFormat='{}Mã phiên bản: {0}'}" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding SelectedVersion.CreatedAt, StringFormat='{}Tạo lúc: {0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource TextCaption}" Margin="0,4,0,8"/>
                                        <TextBox Text="{Binding SelectedVersion.FinalPromptSnapshot, Mode=OneWay}" TextWrapping="Wrap" IsReadOnly="True" MaxHeight="96" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt bất biến của phiên bản"/>
                                    </StackPanel>
                                </Expander>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Header="So sánh">
                        <Grid Margin="4,16,4,4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,16">
                                <TextBlock Text="A" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="112" ItemsSource="{Binding ConceptVersions}" SelectedItem="{Binding CompareVersionLeft}" DisplayMemberPath="VersionNumber" AutomationProperties.Name="Phiên bản A" Margin="0,0,16,0"/>
                                <TextBlock Text="B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <ComboBox Width="112" ItemsSource="{Binding ConceptVersions}" SelectedItem="{Binding CompareVersionRight}" DisplayMemberPath="VersionNumber" AutomationProperties.Name="Phiên bản B" Margin="0,0,16,0"/>
                                <Button Content="So sánh hai phiên bản" Command="{Binding CompareVersionsCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                            </WrapPanel>
                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <components:ImageViewport Source="{Binding CompareLeftImage}" AutomationProperties.Name="Ảnh phiên bản A"/>
                                <components:ImageViewport Grid.Column="2" Source="{Binding CompareRightImage}" AutomationProperties.Name="Ảnh phiên bản B"/>
                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Header="Phê duyệt">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,20,16,16">
                                <TextBlock Text="Đánh giá phiên bản đang chọn" Style="{StaticResource TextSection}"/>
                                <TextBlock Text="{Binding SelectedVersion.VersionNumber, StringFormat='{}Phiên bản {0}'}" Margin="0,8,0,4"/>
                                <TextBlock Text="{Binding SelectedVersion.Status, Converter={StaticResource StatusTextConverter}}" Style="{StaticResource TextSecondary}" Margin="0,0,0,20"/>
                                <StackPanel Margin="0,0,0,16">
                                    <TextBlock Text="Nhận xét / lý do từ chối" Style="{StaticResource TextBody}"/>
                                    <TextBox Text="{Binding ApprovalComment, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Nhận xét / lý do từ chối" TextWrapping="Wrap" AcceptsReturn="True" Height="90"/>
                                </StackPanel>
                                <WrapPanel IsEnabled="{Binding CanManageProject}">
                                    <Button Content="Phê duyệt phiên bản" Command="{Binding ApproveConceptCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                                    <Button Content="Từ chối phiên bản" Command="{Binding RejectConceptCommand}" Style="{StaticResource BtnDanger}" Margin="0,0,8,0"/>
                                </WrapPanel>
                                <TextBlock Text="Chỉ chủ dự án có thể đưa ra quyết định. Quyết định áp dụng đúng mã phiên bản đang chọn." Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,16,0,24"/>
                                <TextBlock Text="Lịch sử quyết định" Style="{StaticResource TextSection}" Margin="0,0,0,16"/>
                                <ItemsControl ItemsSource="{Binding SelectedVersion.Approvals}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,0,1" Padding="0,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Decision, Converter={StaticResource StatusTextConverter}}" FontWeight="SemiBold"/>
                                                    <TextBlock Text="{Binding Comment}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                                    <TextBlock Text="{Binding ReviewerName}" Style="{StaticResource TextCaption}" Margin="0,8,0,0"/>
                                                    <TextBlock Text="{Binding ReviewedAt, StringFormat='{}{0:dd/MM/yyyy HH:mm}'}" Style="{StaticResource TextCaption}"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>
            </Grid>
        </Grid>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Trước" Command="{Binding PreviousConceptPageCommand}" Style="{StaticResource BtnGhost}"/>
            <TextBlock Text="{Binding ConceptPageLabel}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource TextCaption}"/>
            <Button Content="Sau" Command="{Binding NextConceptPageCommand}" Style="{StaticResource BtnGhost}"/>
        </StackPanel>
    </Grid>
</UserControl>
