<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:components="clr-namespace:CharacterConceptAI.Desktop.Components"
             x:Class="CharacterConceptAI.Desktop.Features.Views.StudioView">
    <UserControl.Resources>
        <Style x:Key="DreaminaPillButton" TargetType="Button">
            <Setter Property="Background" Value="{DynamicResource BrushEmerald}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushOnEmerald}"/>
            <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Pill"
                                Background="{TemplateBinding Background}"
                                CornerRadius="19"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BrushEmeraldHover}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Pill" Property="Background" Value="{DynamicResource BrushEmeraldPressed}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Pill" Property="Opacity" Value="0.40"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Crisp rounded tool button inside the floating composer: Bold & High Contrast -->
        <Style x:Key="ComposerToolBtn" TargetType="Button" BasedOn="{StaticResource BtnGhost}">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="Transparent" CornerRadius="16" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrushHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrushSelected}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ShowcaseCardButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Panel.ZIndex" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="CardRoot" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <TransformGroup>
                                    <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1"/>
                                    <TranslateTransform x:Name="CardLift" Y="0"/>
                                </TransformGroup>
                            </Grid.RenderTransform>

                            <Border x:Name="CardFrame"
                                    CornerRadius="16"
                                    BorderBrush="#26FFFFFF"
                                    BorderThickness="1.2"
                                    Background="#0D0F0D"
                                    SnapsToDevicePixels="True">
                                <Border.Effect>
                                    <DropShadowEffect x:Name="CardGlow"
                                                      Color="#B8E600"
                                                      BlurRadius="22"
                                                      ShadowDepth="0"
                                                      Opacity="0"/>
                                </Border.Effect>

                                <Grid>
                                    <!-- Rounded full-bleed artwork with GPU smooth hover zoom inside exact rounded corners -->
                                    <Border x:Name="ArtworkHost" CornerRadius="14.8">
                                        <Border.Background>
                                            <ImageBrush ImageSource="{Binding Path=(components:BentoShowcaseCard.ImageSource), RelativeSource={RelativeSource TemplatedParent}}"
                                                        Stretch="UniformToFill"
                                                        AlignmentX="Center"
                                                        AlignmentY="{Binding Path=(components:BentoShowcaseCard.ImageAlignmentY), RelativeSource={RelativeSource TemplatedParent}}"
                                                        RenderOptions.BitmapScalingMode="HighQuality">
                                                <ImageBrush.RelativeTransform>
                                                    <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1"/>
                                                </ImageBrush.RelativeTransform>
                                            </ImageBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Subtle glossy highlight sweep on hover -->
                                    <Border x:Name="SheenOverlay"
                                            CornerRadius="14.8"
                                            Opacity="0"
                                            IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                <GradientStop Color="#44FFFFFF" Offset="0"/>
                                                <GradientStop Color="#14C4F135" Offset="0.38"/>
                                                <GradientStop Color="#00000000" Offset="0.72"/>
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!-- Hover-only editorial reveal HUD (zero text clutter at rest) -->
                                    <Grid x:Name="HoverHud" Opacity="0" IsHitTestVisible="False">
                                        <Border CornerRadius="14.8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0.34" EndPoint="0,1">
                                                    <GradientStop Color="#00000000" Offset="0"/>
                                                    <GradientStop Color="#7A050705" Offset="0.58"/>
                                                    <GradientStop Color="#EB050705" Offset="1"/>
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>

                                        <!-- Top-left glass style badge (rounded rectangle matching outer card) -->
                                        <Border HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Margin="12,12,0,0"
                                                Padding="10,5"
                                                CornerRadius="8"
                                                Background="#CC0A0D08"
                                                BorderBrush="#99C8F53B"
                                                BorderThickness="1">
                                            <TextBlock Text="{Binding Path=(components:BentoShowcaseCard.StyleTag), RelativeSource={RelativeSource TemplatedParent}}"
                                                       FontSize="11.5"
                                                       FontWeight="SemiBold"
                                                       Foreground="#E5FF78"/>
                                        </Border>

                                        <!-- Bottom title + ratio + rounded-rectangle action badge -->
                                        <Grid VerticalAlignment="Bottom" Margin="14,0,14,13">
                                            <Grid.RenderTransform>
                                                <TranslateTransform x:Name="HudSlide" Y="10"/>
                                            </Grid.RenderTransform>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="0,0,10,0">
                                                <TextBlock Text="{Binding Path=(components:BentoShowcaseCard.Title), RelativeSource={RelativeSource TemplatedParent}}"
                                                           FontSize="14.5"
                                                           FontWeight="Bold"
                                                           Foreground="#FFFFFF"
                                                           TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Text="{Binding Path=(components:BentoShowcaseCard.RatioTag), RelativeSource={RelativeSource TemplatedParent}}"
                                                           FontSize="11.5"
                                                           FontWeight="Medium"
                                                           Foreground="#D2D8CE"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Border Grid.Column="1"
                                                    VerticalAlignment="Bottom"
                                                    Padding="12,6"
                                                    CornerRadius="8"
                                                    Background="#C8F53B">
                                                <TextBlock Text="Dùng mẫu ↗"
                                                           FontSize="11.5"
                                                           FontWeight="Bold"
                                                           Foreground="#0A0E06"/>
                                            </Border>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Grid>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Panel.ZIndex" Value="20"/>
                                <Setter TargetName="CardFrame" Property="BorderBrush" Value="#C8F53B"/>
                                <Setter TargetName="CardFrame" Property="BorderThickness" Value="1.8"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkHost"
                                                             Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                             To="1.045" Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkHost"
                                                             Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                             To="1.045" Duration="0:0:0.30">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardLift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="-3" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.52" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="SheenOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.24"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverHud"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="1" Duration="0:0:0.20"/>
                                            <DoubleAnimation Storyboard.TargetName="HudSlide"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkHost"
                                                             Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)"
                                                             To="1.0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="ArtworkHost"
                                                             Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)"
                                                             To="1.0" Duration="0:0:0.26">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardLift"
                                                             Storyboard.TargetProperty="Y"
                                                             To="0" Duration="0:0:0.22">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                            <DoubleAnimation Storyboard.TargetName="CardGlow"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="SheenOverlay"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.22"/>
                                            <DoubleAnimation Storyboard.TargetName="HoverHud"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0" Duration="0:0:0.18"/>
                                            <DoubleAnimation Storyboard.TargetName="HudSlide"
                                                             Storyboard.TargetProperty="Y"
                                                             To="10" Duration="0:0:0.18"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="0.985" Duration="0:0:0.08"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="0.985" Duration="0:0:0.08"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleX"
                                                             To="1.0" Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="PressScale"
                                                             Storyboard.TargetProperty="ScaleY"
                                                             To="1.0" Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Circular Voice Waveform Button (White on Dark / Black on Light; Emerald+Gold while recording) -->
        <Style x:Key="VoiceWaveButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="MinHeight" Value="40"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="{DynamicResource BrushVoicePillBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushVoicePillFg}"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Circle"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.88"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.74"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Circle" Property="Opacity" Value="0.45"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsVoiceRecording}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushEmerald}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushOnEmerald}"/>
                    <Setter Property="BorderBrush" Value="#000000"/>
                    <Setter Property="BorderThickness" Value="2"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsVoiceTranscribing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource BrushSelected}"/>
                    <Setter Property="Foreground" Value="{DynamicResource BrushGold}"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource BrushGold}"/>
                    <Setter Property="BorderThickness" Value="1.5"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Floating Circular Lightbox Prev / Next Navigation Button -->
        <Style x:Key="LightboxNavButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="46"/>
            <Setter Property="MinHeight" Value="46"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="#CC0A0A0A"/>
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#55FFFFFF"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="23">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrushEmerald}"/>
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="#000000"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushOnEmerald}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource BrushEmeraldPressed}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushOnEmerald}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.22"/>
                                <Setter Property="Cursor" Value="Arrow"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Subtle Emerald & Gold Radial Atmosphere on Empty Home -->
        <Border Grid.RowSpan="2"
                Background="{DynamicResource BrushHeroAura}"
                IsHitTestVisible="False"
                Visibility="{Binding IsChatEmpty, Converter={StaticResource BooleanToVisibilityConverter}}"/>

        <!-- ROW 0: CENTERED MINIMALIST HOME | FAVORITES GALLERY | AI CHAT STREAM -->
        <Grid Grid.Row="0">
            <!-- State A: Pure Text-Free Asymmetric Bento Showcase Wall (14 Multi-Style Curated Prompts) -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding IsChatEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch" MaxWidth="1220" Margin="14,12,18,22">

                    <!-- Bento Cluster 1: Balanced Aspect-Preserving 7-Tile Composition -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.28*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.30*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="240"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="340"/>
                        </Grid.RowDefinitions>

                        <!-- Tile 1: Tall Left Portrait (RPG Fantasy) -->
                        <Button Grid.Row="0" Grid.RowSpan="3" Grid.Column="0"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="frost-mage"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_frost_mage.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Top"
                                components:BentoShowcaseCard.Title="Nữ pháp sư băng giá"
                                components:BentoShowcaseCard.StyleTag="RPG Giả tưởng"
                                components:BentoShowcaseCard.RatioTag="3:4 · Chân dung điện ảnh"/>

                        <!-- Tile 2: Wide Top-Center Hero (Sci-Fi Space — ~97% original frame kept!) -->
                        <Button Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="3"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="mars-climax"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_mars_climax.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Center"
                                components:BentoShowcaseCard.Title="Chân trời Sao Hỏa"
                                components:BentoShowcaseCard.StyleTag="Sci-Fi Vũ trụ"
                                components:BentoShowcaseCard.RatioTag="16:9 · Toàn cảnh điện ảnh"/>

                        <!-- Tile 3: Top-Right Landscape (Mythical Creature — ~99% original frame kept!) -->
                        <Button Grid.Row="0" Grid.Column="6"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="ice-dragon"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_ice_dragon.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Center"
                                components:BentoShowcaseCard.Title="Rồng Pha Lê dưới trăng"
                                components:BentoShowcaseCard.StyleTag="Sinh vật 3D"
                                components:BentoShowcaseCard.RatioTag="4:3 · Kỳ ảo phát sáng"/>

                        <!-- Tile 4: Mid-Center-Left Square (Anime Illustration — ~99% original frame kept!) -->
                        <Button Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="anime-sakura"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_anime_sakura.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Top"
                                components:BentoShowcaseCard.Title="Mùa hoa anh đào"
                                components:BentoShowcaseCard.StyleTag="Minh họa Anime"
                                components:BentoShowcaseCard.RatioTag="1:1 · Ánh sáng trong trẻo"/>

                        <!-- Tile 5: Mid-Center-Right Square (Oil Painting — ~99% original frame kept!) -->
                        <Button Grid.Row="2" Grid.Column="4"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="venice-oil"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_venice_oil.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Center"
                                components:BentoShowcaseCard.Title="Hoàng hôn kênh Venice"
                                components:BentoShowcaseCard.StyleTag="Tranh Sơn dầu"
                                components:BentoShowcaseCard.RatioTag="1:1 · Hội họa cổ điển"/>

                        <!-- Tile 6: Bottom Wide Feature (Contemporary Architecture — generous height preserves roof & pool!) -->
                        <Button Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="5"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="arch-villa"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_arch_villa.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Center"
                                components:BentoShowcaseCard.Title="Biệt thự kính vách núi"
                                components:BentoShowcaseCard.StyleTag="Kiến trúc"
                                components:BentoShowcaseCard.RatioTag="16:9 · Đương đại tối giản"/>

                        <!-- Tile 7: Tall Right Portrait (Cyberpunk Volt-Neon) -->
                        <Button Grid.Row="2" Grid.RowSpan="3" Grid.Column="6"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="cyber-neon"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_cyber_neon.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Top"
                                components:BentoShowcaseCard.Title="Chiến binh Neon đêm mưa"
                                components:BentoShowcaseCard.StyleTag="Cyberpunk"
                                components:BentoShowcaseCard.RatioTag="3:4 · Ánh sáng đô thị"/>
                    </Grid>

                    <!-- Bento Cluster 2: Mirrored 7-Tile Showcase (Scroll for 7 More Styles) -->
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.30*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="0.92*"/>
                            <ColumnDefinition Width="12"/>
                            <ColumnDefinition Width="1.28*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="260"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="240"/>
                            <RowDefinition Height="12"/>
                            <RowDefinition Height="340"/>
                        </Grid.RowDefinitions>

                        <!-- Tile 8: Top-Left Landscape (Product Macro) -->
                        <Button Grid.Row="0" Grid.Column="0"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="watch-macro"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_watch_macro.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Center"
                                components:BentoShowcaseCard.Title="Đồng hồ cơ lộ máy"
                                components:BentoShowcaseCard.StyleTag="Sản phẩm Macro"
