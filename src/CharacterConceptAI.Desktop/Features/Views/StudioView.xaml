                </StackPanel>
            </ScrollViewer>

            <!-- State B: Full-Width Favorites Masonry Gallery -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding ShowFavoritesGallery, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel HorizontalAlignment="Stretch" Margin="8,4,14,18">
                    <Grid Margin="0,0,0,18">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Star}" Style="{StaticResource LucideIconLarge}" Stroke="{DynamicResource BrushGold}" Fill="{DynamicResource BrushGold}" Margin="0,0,10,0"/>
                            <TextBlock Text="Bộ sưu tập Yêu thích" Style="{StaticResource TextPageTitle}" FontSize="22" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding ExitFavoritesModeCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.ArrowLeft}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                <TextBlock Text="Quay lại chat" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </Grid>
                    <Border Style="{StaticResource Card}" Padding="36" Visibility="{Binding HasFavoriteImages, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
                        <StackPanel HorizontalAlignment="Center">
                            <Path Data="{StaticResource Icon.Star}" Width="34" Height="34" Stretch="Uniform" Stroke="{DynamicResource BrushGold}" StrokeThickness="1.6" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Chưa có ảnh yêu thích nào" FontSize="{DynamicResource FontSizeSection}" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Nhấn biểu tượng ngôi sao dưới bất kỳ ảnh nào bạn ưng ý để ghim vào bộ sưu tập này." Style="{StaticResource TextSecondary}" Margin="0,6,0,0" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <ItemsControl ItemsSource="{Binding FavoriteImages}" Visibility="{Binding HasFavoriteImages, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="308" Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Margin="0,0,14,14">
                                    <StackPanel>
                                        <Button Command="{Binding DataContext.OpenImageLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                            <Border Height="290" Width="306" CornerRadius="15,15,0,0" ClipToBounds="True" Background="{DynamicResource BrushCanvas}">
                                                <Grid>
                                                    <Image Source="{Binding DisplayImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="10" Background="{DynamicResource BrushBadgeDark}" CornerRadius="12" Padding="9,3">
                                                        <TextBlock Text="{Binding ResolutionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="10" Background="{DynamicResource BrushBadgeEmerald}" CornerRadius="12" Padding="9,3">
                                                        <TextBlock Text="{Binding ModeBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                    </Border>
                                                </Grid>
                                            </Border>
                                        </Button>
                                        <StackPanel Margin="12,10">
                                            <TextBlock Text="{Binding PromptSnapshot}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource BrushTextPrimary}" ToolTip="{Binding PromptSnapshot}"/>
                                            <WrapPanel Margin="0,8,0,0">
                                                <Button Content="Soi 1:1" Command="{Binding DataContext.OpenImageLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="28" Padding="9,2" FontSize="12" Margin="0,0,5,4"/>
                                                <Button Content="Dùng prompt" Command="{Binding DataContext.ReuseFavoritePromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="8,2" FontSize="12" Margin="0,0,5,4" ToolTip="Đưa prompt này lên khung chat để vẽ tiếp"/>
                                                <Button Content="Tải về" Command="{Binding DataContext.SaveImageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="8,2" FontSize="12" Margin="0,0,5,4"/>
                                                <Button Content="2× Full" Command="{Binding DataContext.UpscaleTurnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="8,2" FontSize="12" Margin="0,0,5,4" Visibility="{Binding CanUpscale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                <Button Command="{Binding DataContext.ToggleFavoriteImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="7,2" Margin="0,0,0,4" ToolTip="{Binding FavoriteTooltip}">
                                                    <Path Data="{StaticResource Icon.Star}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Fill="{DynamicResource BrushGold}"/>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- State C: Expansive Full-Width AI Chat Conversation Stream -->
            <ScrollViewer x:Name="ChatScrollViewer"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Visibility="{Binding HasActiveChatTurns, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ItemsControl ItemsSource="{Binding ActiveChatTurns}" MaxWidth="1480" HorizontalAlignment="Stretch" Margin="12,4,16,18">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,28">
                                <!-- User Prompt Bubble (Refined Matte Emerald Tint, Hairline Border) -->
                                <Border HorizontalAlignment="Right"
                                        MaxWidth="1040"
                                        Background="{DynamicResource BrushChatUserBubble}"
                                        BorderBrush="{DynamicResource BrushBorderSubtle}"
                                        BorderThickness="1"
                                        CornerRadius="20,20,6,20"
                                        Padding="18,13"
                                        Margin="48,0,0,14">
                                    <StackPanel>
                                        <TextBox Text="{Binding UserPrompt, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 Background="Transparent"
                                                 BorderThickness="0"
                                                 Padding="0"
                                                 MinHeight="0"
                                                 FontSize="{DynamicResource FontSizeBody}"
                                                 TextWrapping="Wrap"
                                                 Foreground="{DynamicResource BrushTextPrimary}"
                                                 VerticalScrollBarVisibility="Disabled"
                                                 HorizontalScrollBarVisibility="Disabled"
                                                 PreviewMouseWheel="ChatBubbleTextBox_PreviewMouseWheel"
                                                 Cursor="IBeam">
                                            <TextBox.Template>
                                                <ControlTemplate TargetType="TextBox">
                                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled"/>
                                                </ControlTemplate>
                                            </TextBox.Template>
                                        </TextBox>
                                        <Grid Margin="0,9,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="0,0,12,0">
                                                <Button Command="{Binding DataContext.CopyTurnPromptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource ComposerToolBtn}"
                                                        MinHeight="24"
                                                        Padding="6,2"
                                                        Margin="0,0,8,0"
                                                        ToolTip="Sao chép toàn bộ prompt này">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Path Data="{StaticResource Icon.Copy}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.8" Margin="0,0,5,0"/>
                                                        <TextBlock Text="Sao chép" FontSize="11.5" VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Button>
                                                <Border Background="{DynamicResource BrushCard}" CornerRadius="12" Padding="8,2" Margin="0,0,6,0" Visibility="{Binding HasStyleBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding StylePreset}" FontSize="11" Foreground="{DynamicResource BrushGold}"/>
                                                </Border>
                                                <Border Background="{DynamicResource BrushCard}" CornerRadius="12" Padding="8,2" Visibility="{Binding HasOverlayBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <TextBlock Text="{Binding OverlayBadgeText}" FontSize="11" Foreground="{DynamicResource BrushPositive}"/>
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ResolutionLabel}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding ModeLabel}" FontSize="11.5" Foreground="{DynamicResource BrushGold}" Margin="0,0,8,0"/>
                                                <TextBlock Text="{Binding TimeLabel}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}"/>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- AI Assistant Response -->
                                <Grid Margin="0,0,12,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="38"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <Border Width="30" Height="30" CornerRadius="10" Background="#000000" BorderBrush="{DynamicResource BrushEmerald}" BorderThickness="1" Padding="2" VerticalAlignment="Top" HorizontalAlignment="Left" Margin="0,1,0,0">
                                        <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>

                                    <StackPanel Grid.Column="1">
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,10">
                                            <TextBlock Text="Gula Studio" FontWeight="SemiBold" FontSize="13.5" Foreground="{DynamicResource BrushTextPrimary}" Margin="0,0,10,0"/>
                                            <TextBlock Text="{Binding StatusText}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Aspect-Matched Generating Card (Matches exact 1:1 / 3:4 / 2:3 / 16:9 size of target artwork!) -->
                                        <Viewbox Stretch="Uniform"
                                                 StretchDirection="DownOnly"
                                                 HorizontalAlignment="Left"
                                                 Visibility="{Binding IsGenerating, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Border Width="{Binding GeneratingCardWidth}"
                                                    Height="{Binding GeneratingCardHeight}"
                                                    Background="{DynamicResource BrushCard}"
                                                    BorderBrush="{DynamicResource BrushBorderStrong}"
                                                    BorderThickness="1"
                                                    CornerRadius="16"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Background="{DynamicResource BrushBadgeDark}" CornerRadius="12" Padding="10,4">
                                                        <TextBlock Text="{Binding ResolutionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                    </Border>
                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" Background="{DynamicResource BrushBadgeEmerald}" CornerRadius="12" Padding="10,4">
                                                        <TextBlock Text="{Binding ModeLabel}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                    </Border>
                                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
                                                        <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Width="54" Height="54" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                                                        <TextBlock Text="Đang sáng tạo tác phẩm trên GPU…" FontSize="{DynamicResource FontSizeSubtitle}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" HorizontalAlignment="Center" TextAlignment="Center"/>
                                                        <TextBlock Text="{Binding StatusText}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Medium" Foreground="{DynamicResource BrushTextSecondary}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </Viewbox>

                                        <!-- Error Banner -->
                                        <Border HorizontalAlignment="Left" MaxWidth="640"
                                                Background="{DynamicResource BrushCard}"
                                                BorderBrush="{DynamicResource BrushBorderStrong}"
                                                BorderThickness="1"
                                                CornerRadius="14"
                                                Padding="14,10"
                                                Visibility="{Binding HasError, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <StackPanel>
                                                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource BrushNegative}" TextWrapping="Wrap" FontSize="13"/>
                                                <Button Content="Đưa lại prompt lên khung chat"
                                                        Command="{Binding DataContext.RemixTurnCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Style="{StaticResource BtnGhost}"
                                                        HorizontalAlignment="Left"
                                                        Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>

                                        <!-- Completed Single Artwork Card -->
                                        <ItemsControl ItemsSource="{Binding Images}" Visibility="{Binding IsSingleImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel>
                                                        <Button Command="{Binding DataContext.OpenImageLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                HorizontalAlignment="Left"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="0"
                                                                Cursor="Hand"
                                                                ToolTip="Nhấn để phóng to Soi 1:1 / So sánh Trước-Sau">
                                                            <Border CornerRadius="16"
                                                                    ClipToBounds="True"
                                                                    Background="{DynamicResource BrushCard}"
                                                                    BorderBrush="{DynamicResource BrushBorderSubtle}"
                                                                    BorderThickness="1"
                                                                    MaxWidth="1120"
                                                                    MaxHeight="720">
                                                                <Grid>
                                                                    <Image Source="{Binding DisplayImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="12" Background="{DynamicResource BrushBadgeDark}" CornerRadius="12" Padding="10,4">
                                                                        <TextBlock Text="{Binding ResolutionLabel}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                                    </Border>
                                                                    <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="12" Background="{DynamicResource BrushBadgeEmerald}" CornerRadius="12" Padding="10,4">
                                                                        <TextBlock Text="{Binding ModeBadge}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                                    </Border>
                                                                    <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="12" Background="{DynamicResource BrushBadgeDark}" CornerRadius="12" Padding="14,6" Visibility="{Binding IsUpscaling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                        <TextBlock Text="Đang nâng cấp nét Full 2×…" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}"/>
                                                                    </Border>
                                                                </Grid>
                                                            </Border>
                                                        </Button>

                                                        <WrapPanel Margin="0,10,0,0">
                                                            <Button Command="{Binding DataContext.OpenImageLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="11,4" FontSize="12.5" Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource Icon.Maximize}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="Soi 1:1" FontSize="12.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.UpscaleTurnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="11,4" FontSize="12.5" Margin="0,0,6,4" Visibility="{Binding CanUpscale, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Tăng gấp đôi độ phân giải &amp; độ nét trên GPU">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="Nâng cấp 2×" FontSize="12.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.SaveImageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4" FontSize="12.5" Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource Icon.Download}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                                                    <TextBlock Text="Tải về" FontSize="12.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Command="{Binding DataContext.CopyImageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4" FontSize="12.5" Margin="0,0,6,4">
                                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                                    <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource LucideIconSmall}" Margin="0,0,5,0"/>
                                                                    <TextBlock Text="Sao chép" FontSize="12.5" VerticalAlignment="Center"/>
                                                                </StackPanel>
                                                            </Button>
                                                            <Button Content="{Binding SeedLabel}" Command="{Binding DataContext.UseImageSeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="32" Padding="10,4" FontSize="12" Margin="0,0,6,4" ToolTip="Nhấn để khóa đúng Seed này" Visibility="{Binding HasSeed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                            <Button Command="{Binding DataContext.ToggleFavoriteImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnIcon}" Width="32" Height="32" MinHeight="32" Margin="0,0,4,4" ToolTip="{Binding FavoriteTooltip}">
                                                                <Grid>
                                                                    <Path Data="{StaticResource Icon.Star}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Fill="{DynamicResource BrushGold}" Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                    <Path Data="{StaticResource Icon.Star}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushTextSecondary}" Fill="Transparent" Visibility="{Binding IsFavorite, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                </Grid>
                                                            </Button>
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Completed Multi-Image 2x2 Grid -->
                                        <ItemsControl ItemsSource="{Binding Images}" MaxWidth="1360" HorizontalAlignment="Left" Visibility="{Binding IsMultiImage, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Margin="0,0,12,12">
                                                        <StackPanel>
                                                            <Button Command="{Binding DataContext.OpenImageLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="0"
                                                                    Cursor="Hand">
