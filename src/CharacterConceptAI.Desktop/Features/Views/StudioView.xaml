                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="aodai-lotus"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_aodai_lotus.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Top"
                                components:BentoShowcaseCard.Title="Áo dài lụa bên hồ sen"
                                components:BentoShowcaseCard.StyleTag="Chân thực Việt Nam"
                                components:BentoShowcaseCard.RatioTag="3:4 · Ánh nắng hoàng hôn"/>

                        <!-- Tile 12: Mid-Center-Left Square (Editorial Fashion) -->
                        <Button Grid.Row="2" Grid.Column="2"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="luxury-suit"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_luxury_suit.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Top"
                                components:BentoShowcaseCard.Title="Thời trang Suit quý ông"
                                components:BentoShowcaseCard.StyleTag="Thời trang Editorial"
                                components:BentoShowcaseCard.RatioTag="1:1 · Lookbook cao cấp"/>

                        <!-- Tile 13: Mid-Center-Right Square (Medieval Armor) -->
                        <Button Grid.Row="2" Grid.Column="4"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="knight-armor"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_knight_armor.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Top"
                                components:BentoShowcaseCard.Title="Nữ hiệp sĩ thành cổ"
                                components:BentoShowcaseCard.StyleTag="Giả tưởng Trung cổ"
                                components:BentoShowcaseCard.RatioTag="3:4 · Giáp thép phản sáng"/>

                        <!-- Tile 14: Bottom Wide Right (Misty Sunrise Landscape) -->
                        <Button Grid.Row="4" Grid.Column="2" Grid.ColumnSpan="5"
                                Style="{StaticResource ShowcaseCardButton}"
                                Command="{Binding ApplyDreaminaShowcaseCommand}" CommandParameter="mountain-dawn"
                                components:BentoShowcaseCard.ImageSource="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Showcase/bento_mountain_dawn.jpg"
                                components:BentoShowcaseCard.ImageAlignmentY="Center"
                                components:BentoShowcaseCard.Title="Bình minh sương mờ đỉnh núi"
                                components:BentoShowcaseCard.StyleTag="Phong cảnh điện ảnh"
                                components:BentoShowcaseCard.RatioTag="16:9 · Thiên nhiên hữu tình"/>
