                                                                    <Grid>
                                                                        <Image Source="{Binding DisplayImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="8" Background="{DynamicResource BrushBadgeDark}" CornerRadius="12" Padding="8,3">
                                                                            <TextBlock Text="{Binding ResolutionLabel}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                                        </Border>
                                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="8" Background="{DynamicResource BrushBadgeEmerald}" CornerRadius="12" Padding="8,3">
                                                                            <TextBlock Text="{Binding ModeBadge}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                                        </Border>
                                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="8" Background="{DynamicResource BrushBadgeDark}" CornerRadius="12" Padding="10,4" Visibility="{Binding IsUpscaling, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                                            <TextBlock Text="Đang nâng cấp 2×…" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}"/>
                                                                        </Border>
                                                                    </Grid>
                                                                </Border>
                                                            </Button>
                                                            <WrapPanel Margin="8,6">
                                                                <Button Content="Soi 1:1" Command="{Binding DataContext.OpenImageLightboxCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="26" Padding="8,2" FontSize="11.5" Margin="0,0,4,0"/>
                                                                <Button Content="2× Full" Command="{Binding DataContext.UpscaleTurnImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnSecondary}" MinHeight="26" Padding="8,2" FontSize="11.5" Margin="0,0,4,0" Visibility="{Binding CanUpscale, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <Button Content="Lưu" Command="{Binding DataContext.SaveImageItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="26" Padding="7,2" FontSize="11.5" Margin="0,0,4,0"/>
                                                                <Button Content="{Binding SeedLabel}" Command="{Binding DataContext.UseImageSeedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="26" Padding="7,2" FontSize="11" Margin="0,0,4,0" Visibility="{Binding HasSeed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                <Button Command="{Binding DataContext.ToggleFavoriteImageCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" MinHeight="26" Padding="6,0" ToolTip="{Binding FavoriteTooltip}">
                                                                    <Grid>
                                                                        <Path Data="{StaticResource Icon.Star}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Fill="{DynamicResource BrushGold}" Visibility="{Binding IsFavorite, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                                        <Path Data="{StaticResource Icon.Star}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushTextSecondary}" Fill="Transparent" Visibility="{Binding IsFavorite, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                                    </Grid>
                                                                </Button>
                                                            </WrapPanel>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>

        <!-- ROW 1: FULL-WIDTH FLOATING PILL COMPOSER (Aligned to 1480px Main Content Width) -->
        <StackPanel Grid.Row="1" MaxWidth="1480" HorizontalAlignment="Stretch" Margin="12,6,16,2" AllowDrop="True" PreviewDragOver="Composer_DragOver" Drop="Composer_Drop">

            <!-- Popover 1: Poster / Text Overlay Builder -->
            <Border Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="20" Padding="14,12" Margin="0,0,0,8" Visibility="{Binding IsTextOverlayOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="8"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Chữ hiển thị trên ảnh (Poster / Typography)" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding OverlayText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Chữ hiển thị trên ảnh" ToolTip="Ví dụ: CÀ PHÊ SÀI GÒN hoặc SALE 50%"/>
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Kiểu chữ" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableOverlayTextStyles}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding OverlayTextStyle}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Vị trí" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableOverlayTextPositions}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding OverlayTextPosition}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Bottom">
                        <Button Content="Xóa" Command="{Binding ClearTextOverlayCommand}" Style="{StaticResource BtnGhost}" MinHeight="34" Padding="10,4" Margin="0,0,4,0"/>
                        <Button Command="{Binding ToggleTextOverlayCommand}" Style="{StaticResource BtnCloseIcon}" ToolTip="Đóng bảng chèn chữ" AutomationProperties.Name="Đóng"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Popover 2: Prompt cuối -->
            <Border Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="20" Padding="14,12" Margin="0,0,0,8" Visibility="{Binding IsPromptPreviewOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,6">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Prompt cuối gửi cho AI" FontWeight="Bold" FontSize="{DynamicResource FontSizeBody}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                            <ComboBox ItemsSource="{Binding AvailablePromptModes}" SelectedItem="{Binding SelectedPromptMode}" Width="140" MinHeight="30" AutomationProperties.Name="Chế độ prompt Raw Structured Hybrid"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Sao chép" Command="{Binding CopyPromptCommand}" Style="{StaticResource BtnGhost}" MinHeight="30" Padding="10,2" Margin="0,0,6,0"/>
                            <Button Command="{Binding TogglePromptPreviewPanelCommand}" Style="{StaticResource BtnCloseIconCompact}" VerticalAlignment="Center" ToolTip="Ẩn bảng prompt" AutomationProperties.Name="Đóng"/>
                        </StackPanel>
                    </Grid>
                    <TextBox Text="{Binding Prompt, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="84" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Prompt cuối được gửi cho máy chủ"/>
                    <TextBlock Text="{Binding PromptWarnings}" Foreground="{DynamicResource BrushWarning}" TextWrapping="Wrap" Margin="0,4,0,0" FontSize="{DynamicResource FontSizeSmall}" Visibility="{Binding PromptWarnings, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                </StackPanel>
            </Border>

            <!-- Popover 3: Unified Studio Pro Options Popover (Style, Lighting, Lens, LoRA Manager, Reasoning, Text, 9-Expr, Seed/Size) -->
            <Border Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="20" Padding="16,14" Margin="0,0,0,8" Visibility="{Binding IsStudioAdvancedOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <ScrollViewer MaxHeight="440" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Str.Studio.ProTitle}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <Button Command="{Binding ToggleStudioAdvancedCommand}" Style="{StaticResource BtnCloseIconCompact}" HorizontalAlignment="Right" ToolTip="{DynamicResource Str.Common.Close}" AutomationProperties.Name="Đóng"/>
                        </Grid>

                        <!-- Row 1: Style Presets -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Str.Studio.Style}" Style="{StaticResource TextCaption}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding AvailableStylePresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.SelectStylePresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}"
                                                MinHeight="28"
                                                Padding="11,2"
                                                Margin="0,0,6,5"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BtnPillToggle}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                    <Binding Path="Key"/>
                                                    <Binding Path="DataContext.SelectedStylePresetKey" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Row 1B: Cinematic Lighting Presets -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Str.Studio.Lighting}" Style="{StaticResource TextCaption}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding AvailableLightingPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.SelectLightingPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}"
                                                MinHeight="28"
                                                Padding="11,2"
                                                Margin="0,0,6,5"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BtnPillToggle}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                    <Binding Path="Key"/>
                                                    <Binding Path="DataContext.SelectedLightingPresetKey" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Row 1C: Camera & Lens Presets -->
                        <StackPanel Margin="0,0,0,10">
                            <TextBlock Text="{DynamicResource Str.Studio.CameraLens}" Style="{StaticResource TextCaption}" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ItemsControl ItemsSource="{Binding AvailableCameraPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}"
                                                Command="{Binding DataContext.SelectCameraPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding Key}"
                                                MinHeight="28"
                                                Padding="11,2"
                                                Margin="0,0,6,5"
                                                FontSize="{DynamicResource FontSizeSmall}"
                                                FontWeight="SemiBold"
                                                Style="{StaticResource BtnPillToggle}">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                    <Binding Path="Key"/>
                                                    <Binding Path="DataContext.SelectedCameraPresetKey" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Row 1D: Curated & Custom LoRA Manager (Z-Image-Turbo Detailer / Realism / Cinema / Anime) -->
                        <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="10,8" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{DynamicResource Str.Studio.LoraTitle}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                        <Border Background="{DynamicResource BrushSelected}" CornerRadius="8" Padding="7,1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ActiveLorasBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSelected}"/>
                                        </Border>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="{DynamicResource Str.Common.Refresh}" Command="{Binding RefreshLoraCatalogCommand}" Style="{StaticResource BtnGhost}" MinHeight="24" Padding="8,1" FontSize="11.5" Margin="0,0,4,0"/>
                                        <Button Content="{DynamicResource Str.Common.OpenFolder}" Command="{Binding OpenLorasFolderCommand}" Style="{StaticResource BtnGhost}" MinHeight="24" Padding="8,1" FontSize="11.5"/>
                                    </StackPanel>
                                </Grid>
                                <TextBlock Text="{DynamicResource Str.Studio.NoLoras}" Style="{StaticResource TextCaption}" Visibility="{Binding HasAvailableLoras, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                <ItemsControl ItemsSource="{Binding AvailableLoras}" Visibility="{Binding HasAvailableLoras, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="8,5" Margin="0,0,8,6" ToolTip="{Binding DescriptionVi}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <CheckBox IsChecked="{Binding IsEnabled}" Content="{Binding DisplayNameVi}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                                    <Slider Minimum="0.10" Maximum="1.20" SmallChange="0.05" Value="{Binding Strength}" Width="66" VerticalAlignment="Center" Margin="0,0,4,0" IsEnabled="{Binding IsEnabled}"/>
                                                    <TextBlock Text="{Binding StrengthLabel}" FontSize="11" Foreground="{DynamicResource BrushGold}" FontWeight="Bold" VerticalAlignment="Center" MinWidth="28"/>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Row 2: Reasoning & Creative Presets -->
                        <WrapPanel Margin="0,0,0,10" VerticalAlignment="Center">
                            <CheckBox Content="{DynamicResource Str.Studio.DeepReasoning}" IsChecked="{Binding EnableReasoningEnhance}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Margin="0,0,14,4" ToolTip="{DynamicResource Str.Studio.DeepReasoning}"/>
                            <Button Command="{Binding ToggleTextOverlayCommand}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="11,3" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,8,4" ToolTip="{DynamicResource Str.Studio.PosterText}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Type}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Str.Studio.PosterText}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ApplyExpressionSheetPresetCommand}" Style="{StaticResource BtnSecondary}" MinHeight="32" Padding="11,3" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,0,4" ToolTip="{DynamicResource Str.Studio.NineExpressions}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Smile}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{DynamicResource Str.Studio.NineExpressions}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </WrapPanel>

                        <!-- Row 3: Fine Controls (Custom Width/Height, Seed, Prompt Mode, Preview) -->
                        <Border BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,1,0,0" Padding="0,10,0,0">
                            <WrapPanel>
                                <StackPanel Width="96" Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Str.Studio.Width}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ImageWidth, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Rộng (px)"/>
                                </StackPanel>
                                <StackPanel Width="96" Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Str.Studio.Height}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding ImageHeight, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Cao (px)"/>
                                </StackPanel>
                                <StackPanel Width="168" Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Str.Studio.Seed}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding GenerationSeed, TargetNullValue='', UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Seed (để trống: ngẫu nhiên)"/>
                                </StackPanel>
                                <StackPanel Width="82" Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Str.Studio.Count}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <TextBox Text="{Binding RequestedImageCount, UpdateSourceTrigger=PropertyChanged, ValidatesOnExceptions=True}" AutomationProperties.Name="Số ảnh yêu cầu"/>
                                </StackPanel>
                                <StackPanel Width="138" Margin="0,0,10,4">
                                    <TextBlock Text="{DynamicResource Str.Studio.PromptMode}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox ItemsSource="{Binding AvailablePromptModes}" SelectedItem="{Binding SelectedPromptMode}"/>
                                </StackPanel>
                                <Button Content="{DynamicResource Str.Studio.PreviewPrompt}" Command="{Binding PreviewPromptCommand}" Style="{StaticResource BtnSecondary}" VerticalAlignment="Bottom" Margin="0,0,0,4"/>
                            </WrapPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Popover 4: Inline Character Profile Picker -->
            <Border Background="{DynamicResource BrushCardElevated}"
                    BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsStudioCharacterPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Users}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Margin="0,0,7,0"/>
                            <TextBlock Text="Chọn Hồ sơ Nhân vật (tự khóa Gương mặt + Tóc + Body DNA)" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Command="{Binding OpenActiveStudioCharacterInStoryCommand}" Style="{StaticResource BtnGhost}" MinHeight="28" Padding="8,2" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,6,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Settings}" Width="13" Height="13" Stretch="Uniform" Stroke="{DynamicResource BrushGold}" StrokeThickness="1.9" Margin="0,0,5,0"/>
                                    <TextBlock Text="Quản lý / thêm" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleStudioCharacterPickerCommand}" Style="{StaticResource BtnCloseIconCompact}" ToolTip="Đóng" AutomationProperties.Name="Đóng chọn nhân vật"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AllSavedCharacters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectStudioCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BtnSecondary}"
                                            Padding="9,6"
                                            Margin="0,0,8,2"
                                            MinHeight="48"
                                            ToolTip="Nhấn để khóa nhân vật này cho các prompt tiếp theo">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="38" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BrushCanvas}" Margin="0,0,8,0">
                                                <Grid>
                                                    <Path Data="{StaticResource Icon.User}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushTextSecondary}" Visibility="{Binding HasFaceAnchor, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    <Image Source="{Binding FacePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ProfileSummaryBadge}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Popover 4B: Inline Secondary Character Picker (Dual-Face Couple Mode — Right Person) -->
            <Border Background="{DynamicResource BrushCardElevated}"
                    BorderBrush="{DynamicResource BrushGold}"
                    BorderThickness="1"
                    CornerRadius="20"
                    Padding="12,10"
                    Margin="0,0,0,8"
                    Visibility="{Binding IsSecondaryCharacterPickerOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.Users}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}" Margin="0,0,7,0"/>
                            <TextBlock Text="Chọn Nhân vật thứ 2 (Bên phải · Khóa gương mặt cặp đôi 2 người)" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding ToggleSecondaryCharacterPickerCommand}" Style="{StaticResource BtnCloseIconCompact}" HorizontalAlignment="Right" ToolTip="Đóng" AutomationProperties.Name="Đóng chọn nhân vật thứ 2"/>
                    </Grid>
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding AllSavedCharacters}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SelectSecondaryStudioCharacterCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource BtnSecondary}"
                                            Padding="9,6"
                                            Margin="0,0,8,2"
                                            MinHeight="48"
                                            ToolTip="Khóa làm nhân vật bên phải trong khung hình 2 người">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="34" Height="38" CornerRadius="8" ClipToBounds="True" Background="{DynamicResource BrushCanvas}" Margin="0,0,8,0">
                                                <Grid>
                                                    <Path Data="{StaticResource Icon.User}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushTextSecondary}" Visibility="{Binding HasFaceAnchor, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                                                    <Image Source="{Binding FacePreview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                </Grid>
                                            </Border>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" HorizontalAlignment="Left"/>
                                                <TextBlock Text="{Binding ProfileSummaryBadge}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Foreground="{DynamicResource BrushGold}" HorizontalAlignment="Left"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Active Context Attachment Chips -->
            <StackPanel>
                <Border Background="{DynamicResource BrushCard}"
                        BorderBrush="{DynamicResource BrushBorderStrong}"
                        BorderThickness="1"
                        CornerRadius="16"
                        Padding="12,8"
                        Margin="0,0,0,8"
                        Visibility="{Binding HasAttachedReference, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="44" Height="44" CornerRadius="8" ClipToBounds="True" Margin="0,0,12,0" Background="{DynamicResource BrushCanvas}">
                            <Image Source="{Binding AttachedReferencePreview}" Stretch="UniformToFill"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding AttachedReferenceName}" FontWeight="Bold" FontSize="{DynamicResource FontSizeSmall}" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding AttachedReferenceSummary}" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,0">
                                <TextBlock Text="Mức biến đổi (Img2Img):" Style="{StaticResource TextCaption}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Slider Minimum="0.2" Maximum="0.95" SmallChange="0.05" Value="{Binding Denoise}" Width="140" VerticalAlignment="Center" AutomationProperties.Name="Mức thay đổi ảnh tham chiếu"/>
                            </StackPanel>
                        </StackPanel>
                        <Button Grid.Column="2" Command="{Binding ClearAttachedReferenceCommand}" Style="{StaticResource BtnCloseIconCompact}" VerticalAlignment="Top" ToolTip="Gỡ ảnh mẫu" AutomationProperties.Name="Gỡ ảnh mẫu"/>
                    </Grid>
                </Border>

                <WrapPanel>
                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,8,8" Visibility="{Binding HasActiveDepthPose, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="28" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}" Margin="0,0,8,0">
                                <Image Source="{Binding ActiveDepthPoseThumb}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding ActiveDepthPoseSummary}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Minimum="0.50" Maximum="1.15" SmallChange="0.05" Value="{Binding ActiveDepthStrength}" Width="74" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Cường độ bám dáng 3D"/>
                            <Button Command="{Binding ClearDepthPoseCommand}" Style="{StaticResource BtnCloseIconCompact}" ToolTip="Bỏ tư thế Depth" AutomationProperties.Name="Bỏ tư thế"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,8,8" Visibility="{Binding HasActiveOutfit, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="28" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}" Margin="0,0,8,0">
                                <Image Source="{Binding ActiveOutfitThumb}" Stretch="Uniform"/>
                            </Border>
                            <TextBlock Text="{Binding ActiveOutfitSummary}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushGold}" VerticalAlignment="Center" Margin="0,0,8,0" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActiveOutfitSummary}"/>
                            <Button Command="{Binding ClearOutfitCommand}" Style="{StaticResource BtnCloseIconCompact}" ToolTip="Bỏ trang phục đã chọn" AutomationProperties.Name="Bỏ trang phục"/>
                        </StackPanel>
                    </Border>

                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,8,8" Visibility="{Binding HasStudioFaceLock, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding OpenStudioFaceLockLightboxCommand}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" Margin="0,0,8,0" ToolTip="Nhấn để phóng to xem ảnh gương mặt đang khóa">
                                <Border Width="24" Height="28" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BrushCanvas}">
                                    <Image Source="{Binding ActiveStudioFacePreview}" Stretch="UniformToFill"/>
                                </Border>
                            </Button>
                            <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushPositive}" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding StudioFaceLockSummary}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <CheckBox Content="Body" IsChecked="{Binding ActiveStudioLockBodyDna}" VerticalAlignment="Center" FontSize="{DynamicResource FontSizeCaption}" Margin="0,0,8,0" Visibility="{Binding HasActiveStudioCharacter, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Tự động bơm chỉ số cơ thể vào mọi prompt"/>
                            <Slider Minimum="0.20" Maximum="1.0" SmallChange="0.05" Value="{Binding ActiveStudioFaceStrength}" Width="70" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Độ giống gương mặt gốc"/>
                            <Button Command="{Binding ToggleSecondaryCharacterPickerCommand}" Style="{StaticResource BtnGhost}" MinHeight="24" Padding="7,1" FontSize="11.5" Margin="0,0,4,0" Visibility="{Binding HasActiveStudioCharacter, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Thêm nhân vật thứ 2 để khóa đồng thời 2 gương mặt (Cặp đôi Trái/Phải)">
                                <TextBlock Text="+ Nhân vật 2" Foreground="{DynamicResource BrushGold}" FontWeight="Bold"/>
                            </Button>
                            <Button Command="{Binding OpenActiveStudioCharacterInStoryCommand}" Style="{StaticResource BtnGhost}" Width="24" Height="24" MinHeight="24" Padding="0" Margin="0,0,2,0" Visibility="{Binding HasActiveStudioCharacter, Converter={StaticResource BooleanToVisibilityConverter}}" ToolTip="Chỉnh sửa hồ sơ nhân vật">
                                <Path Data="{StaticResource Icon.Edit}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource BrushGold}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Button>
                            <Button Command="{Binding ClearStudioFaceLockCommand}" Style="{StaticResource BtnCloseIconCompact}" ToolTip="Tắt khóa nhân vật / mặt" AutomationProperties.Name="Tắt khóa mặt"/>
                        </StackPanel>
                    </Border>

                    <!-- Secondary Character Chip (Dual-Face Couple Lock — Right Person) -->
                    <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="1" CornerRadius="14" Padding="9,4" Margin="0,0,8,8" Visibility="{Binding HasSecondaryStudioCharacter, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="24" Height="28" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource BrushCanvas}" Margin="0,0,8,0">
                                <Image Source="{Binding SecondaryStudioCharacter.FacePreview}" Stretch="UniformToFill"/>
                            </Border>
                            <TextBlock Text="{Binding SecondaryStudioFaceLockSummary}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushGold}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <Slider Minimum="0.20" Maximum="1.0" SmallChange="0.05" Value="{Binding SecondaryStudioFaceStrength}" Width="64" VerticalAlignment="Center" Margin="0,0,6,0" ToolTip="Độ giống gương mặt nhân vật bên phải"/>
                            <Button Content="⇄" Command="{Binding SwapStudioCharactersCommand}" Style="{StaticResource BtnGhost}" Width="26" Height="24" MinHeight="24" Padding="0" Margin="0,0,2,0" FontWeight="Bold" ToolTip="Đổi vị trí Trái ↔ Phải của 2 nhân vật"/>
                            <Button Command="{Binding ClearSecondaryStudioCharacterCommand}" Style="{StaticResource BtnCloseIconCompact}" ToolTip="Gỡ nhân vật thứ 2" AutomationProperties.Name="Gỡ nhân vật 2"/>
                        </StackPanel>
                    </Border>
                </WrapPanel>
            </StackPanel>

            <!-- Live Voice Dictation Status Strip (Visible only while recording or transcribing) -->
            <Border Background="{DynamicResource BrushSelected}"
                    BorderBrush="{DynamicResource BrushGold}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="14,8"
                    Margin="0,0,0,8"
                    Visibility="{Binding ShowVoiceStatusBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
                        <Ellipse Width="10" Height="10" Fill="{DynamicResource BrushGold}" Margin="0,0,9,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding VoiceStatusHeadline}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Grid.Column="1"
                                 Minimum="0" Maximum="100"
                                 Value="{Binding VoiceAudioLevel}"
                                 IsIndeterminate="{Binding IsVoiceTranscribing}"
                                 Height="6"
                                 MaxWidth="220"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource BrushGold}"
                                 Background="{DynamicResource BrushCard}"/>
                    <Button Grid.Column="2"
                            Command="{Binding CancelVoiceInputCommand}"
                            Style="{StaticResource BtnGhost}"
                            MinHeight="28"
                            Padding="10,2"
                            Margin="10,0,0,0"
                            ToolTip="Hủy ghi âm giọng nói (Esc)">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Data="{StaticResource Icon.X}" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="2" Margin="0,0,5,0"/>
                            <TextBlock Text="Hủy" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>

            <!-- FLOATING PILL COMPOSER ([Paperclip] [Prompt] [Voice Circle] + Clean Studio Bar) -->
            <Border Background="{DynamicResource BrushCardElevated}"
                    BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="28"
                    Padding="12,10,12,10">
                <StackPanel>
                    <!-- Row 1: Prompt Row — Inline Paperclip Left + Large Bold Prompt + Circular Voice Waveform Right -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Paperclip Attachment Button inline right next to the prompt -->
                        <Button Grid.Column="0"
                                Command="{Binding BrowseAttachReferenceCommand}"
                                Style="{StaticResource BtnIcon}"
                                Width="38" Height="38" MinHeight="38"
                                Margin="0,1,6,0"
                                VerticalAlignment="Center"
                                ToolTip="Đính kèm ảnh mẫu (Img2Img · hoặc kéo thả ảnh vào khung)"
                                AutomationProperties.Name="Đính kèm ảnh mẫu">
                            <Path Data="{StaticResource Icon.Paperclip}" Width="19" Height="19" Stretch="Uniform" Stroke="{DynamicResource BrushTextPrimary}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>

                        <!-- Frameless Large Bold Prompt Input -->
                        <Grid Grid.Column="1" VerticalAlignment="Center">
                            <TextBox x:Name="PromptInput"
                                     Text="{Binding RawPromptInput, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="{DynamicResource FontSizeSubtitle}"
                                     FontWeight="SemiBold"
                                     Foreground="{DynamicResource BrushTextPrimary}"
                                     TextWrapping="Wrap"
                                     AcceptsReturn="True"
                                     MinHeight="38"
                                     MaxHeight="116"
                                     Padding="4,6"
                                     VerticalContentAlignment="Center"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="PromptInput_PreviewKeyDown"
                                     AutomationProperties.Name="Ý tưởng concept hoặc prompt tự do"/>
                            <TextBlock Text="{DynamicResource Str.Studio.PromptPlaceholder}"
                                       Foreground="{DynamicResource BrushTextMuted}"
                                       FontSize="{DynamicResource FontSizeSubtitle}"
                                       FontWeight="Medium"
                                       Margin="8,0,8,0"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PromptInput}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <!-- Right Cluster on Prompt Row: Inline Quality Mode (Standard / Full 2×) next to Voice Waveform Button -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="6,0,2,0">
                            <ComboBox SelectedIndex="{Binding QualityModeIndex}"
                                      Style="{StaticResource InlinePillComboBox}"
                                      MinWidth="106"
                                      Margin="0,0,6,0"
                                      VerticalAlignment="Center"
                                      AutomationProperties.Name="Chế độ tạo ảnh"
                                      ToolTip="1× / Full 2×">
                                <ComboBoxItem Content="{DynamicResource Str.Studio.QualityStandard}"/>
                                <ComboBoxItem Content="Full 2×" IsEnabled="{Binding IsFullQualityAvailable}"/>
                            </ComboBox>

                            <Button Command="{Binding ToggleVoiceInputCommand}"
                                    Style="{StaticResource VoiceWaveButton}"
                                    VerticalAlignment="Center"
                                    ToolTip="{Binding VoiceButtonToolTip}"
                                    AutomationProperties.Name="Nhập prompt bằng giọng nói">
                                <Grid>
                                    <Path Data="{StaticResource Icon.AudioLines}" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource BrushVoicePillFg}" StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding IsVoiceIdle, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Path Data="{StaticResource Icon.Square}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BrushOnEmerald}" Fill="{DynamicResource BrushOnEmerald}" StrokeThickness="1.6" Visibility="{Binding IsVoiceRecording, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                    <Path Data="{StaticResource Icon.Sparkles}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource BrushGold}" StrokeThickness="2.0" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Visibility="{Binding IsVoiceTranscribing, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!-- Row 2: Studio Tools + External Aspect Ratio & Batch Count Pills + Options & Primary CTA -->
                    <Grid Margin="4,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left & Center: Studio Tools + Aspect Ratio Pill + Batch Count Pill (Wraps smoothly on compact screens) -->
                        <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                            <Button Command="{Binding OpenPoseGalleryForStudioCommand}" Style="{StaticResource ComposerToolBtn}" Padding="8,4" Margin="0,2,2,2" ToolTip="{DynamicResource Str.Studio.Pose3D}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Pose}" Style="{StaticResource LucideIconSmall}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Str.Studio.Pose3D}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding OpenOutfitGalleryForStudioCommand}" Style="{StaticResource ComposerToolBtn}" Padding="8,4" Margin="0,2,2,2" ToolTip="{DynamicResource Str.Studio.Outfits}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Shirt}" Style="{StaticResource LucideIconSmall}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Str.Studio.Outfits}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding ToggleStudioCharacterPickerCommand}" Style="{StaticResource ComposerToolBtn}" Padding="8,4" Margin="0,2,2,2" ToolTip="{DynamicResource Str.Studio.Character}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Users}" Style="{StaticResource LucideIconSmall}" Margin="0,0,5,0"/>
                                    <TextBlock Text="{DynamicResource Str.Studio.Character}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Command="{Binding BrowseStudioFaceLockCommand}" Style="{StaticResource BtnIcon}" Width="34" Height="34" MinHeight="34" Margin="0,2,2,2" ToolTip="Khóa nhanh 1 ảnh gương mặt lẻ" AutomationProperties.Name="Khóa mặt">
                                <Path Data="{StaticResource Icon.Lock}" Style="{StaticResource LucideIconSmall}"/>
                            </Button>
                            <Button Command="{Binding EnhancePromptCommand}" Style="{StaticResource BtnIcon}" Width="34" Height="34" MinHeight="34" Margin="0,2,2,2" ToolTip="AI tự động nâng cấp &amp; trau chuốt prompt (~1.5 giây)" AutomationProperties.Name="Nâng cấp prompt">
                                <Path Data="{StaticResource Icon.Wand}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushGold}"/>
                            </Button>
                            <Button Command="{Binding UndoEnhancePromptCommand}" Style="{StaticResource BtnIcon}" Width="34" Height="34" MinHeight="34" Margin="0,2,2,2" ToolTip="Khôi phục prompt trước khi nâng cấp" Visibility="{Binding CanUndoEnhance, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <Path Data="{StaticResource Icon.Undo}" Style="{StaticResource LucideIconSmall}"/>
                            </Button>

                            <Border Width="1" Height="20" Background="{DynamicResource BrushBorderStrong}" Margin="6,2,8,2" VerticalAlignment="Center"/>

                            <!-- External Aspect Ratio Quick Selector Pill -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="3,2" Margin="0,2,6,2" VerticalAlignment="Center" AutomationProperties.Name="Tỉ lệ khung hình" ToolTip="{Binding AspectRatioSummary}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="1:1" Command="{Binding SetAspectRatioCommand}" CommandParameter="1:1" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveAspectRatioPreset, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=1:1}" Padding="7,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}" ToolTip="Vuông 1024 × 1024"/>
                                    <Button Content="3:4" Command="{Binding SetAspectRatioCommand}" CommandParameter="3:4" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveAspectRatioPreset, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=3:4}" Padding="7,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}" ToolTip="Chân dung 896 × 1152"/>
                                    <Button Content="2:3" Command="{Binding SetAspectRatioCommand}" CommandParameter="2:3" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveAspectRatioPreset, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=2:3}" Padding="7,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}" ToolTip="Dọc 832 × 1216"/>
                                    <Button Content="16:9" Command="{Binding SetAspectRatioCommand}" CommandParameter="16:9" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveAspectRatioPreset, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=16:9}" Padding="7,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}" ToolTip="Ngang 1280 × 704"/>
                                    <Button Content="{DynamicResource Str.Studio.Fast}" Command="{Binding SetAspectRatioCommand}" CommandParameter="512" Style="{StaticResource BtnPillToggle}" Tag="{Binding ActiveAspectRatioPreset, Converter={StaticResource EqualsToSelectedTagConverter}, ConverterParameter=512}" Padding="7,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}" ToolTip="512 × 768"/>
                                </StackPanel>
                            </Border>

                            <!-- External Batch Count Quick Selector Pill -->
                            <Border Background="{DynamicResource BrushCard}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="16" Padding="3,2" Margin="0,2,0,2" VerticalAlignment="Center" AutomationProperties.Name="Số biến thể">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Content="{DynamicResource Str.Studio.Batch1}" Command="{Binding SetBatchCountCommand}" CommandParameter="1" Style="{StaticResource BtnPillToggle}" Tag="{Binding RequestedImageCount, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=1}" Padding="8,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}"/>
                                    <Button Content="{DynamicResource Str.Studio.Batch2}" Command="{Binding SetBatchCountCommand}" CommandParameter="2" Style="{StaticResource BtnPillToggle}" Tag="{Binding RequestedImageCount, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=2}" Padding="8,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}"/>
                                    <Button Content="{DynamicResource Str.Studio.Batch4}" Command="{Binding SetBatchCountCommand}" CommandParameter="4" Style="{StaticResource BtnPillToggle}" Tag="{Binding RequestedImageCount, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=4}" Padding="8,2" MinHeight="28" FontSize="{DynamicResource FontSizeSmall}"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!-- Right: Advanced Options Toggle + Primary #B2CB25 Pill CTA -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Command="{Binding ToggleStudioAdvancedCommand}"
                                    Style="{StaticResource ComposerToolBtn}"
                                    Padding="9,4"
                                    Margin="0,0,6,0"
                                    ToolTip="{DynamicResource Str.Studio.ProTitle}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Sliders}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding StudioOptionsSummary}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding GenerateCommand}"
                                    Style="{StaticResource DreaminaPillButton}"
                                    Height="40"
                                    MinWidth="120"
                                    Padding="18,0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.Name="Gửi tác vụ tạo concept"
                                    ToolTip="{Binding GenerationBlockReason}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Str.Studio.Generate}" Foreground="{DynamicResource BrushOnEmerald}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Subtle Hint Row -->
            <WrapPanel HorizontalAlignment="Center" Margin="0,4,0,0">
                <TextBlock Text="{Binding GenerationBlockReason}" Foreground="{DynamicResource BrushWarning}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="SemiBold" Margin="0,0,10,0" Visibility="{Binding GenerationBlockReason, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                <TextBlock Text="{Binding QualityModeHint}" Style="{StaticResource TextCaption}" Visibility="{Binding QualityModeHint, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
            </WrapPanel>
        </StackPanel>

        <!-- IN-APP 1:1 LIGHTBOX MODAL OVERLAY (With Context-Aware Prev/Next Arrows & Non-Clipped Action Bar) -->
        <Grid Grid.RowSpan="2"
              Panel.ZIndex="20"
              Background="{DynamicResource BrushOverlay}"
              MouseLeftButtonDown="LightboxBackdrop_MouseDown"
              Visibility="{Binding IsLightboxOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource BrushBorderStrong}" CornerRadius="20" Margin="18" Padding="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="18"/>
                        <ColumnDefinition Width="378"/>
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <components:ImageViewport Source="{Binding LightboxDisplayImage}"
                                                  ShowTransparencyGrid="{Binding IsLightboxTransparencyMode}"
                                                  MinHeight="320"
                                                  Visibility="{Binding ShowLightboxStandardView, Converter={StaticResource BooleanToVisibilityConverter}}"
                                                  AutomationProperties.Name="Ảnh concept mới nhất"/>
                        <components:ImageCompareSlider BeforeSource="{Binding LightboxBeforeImage}"
                                                       AfterSource="{Binding LightboxAfterImage}"
                                                       MinHeight="320"
                                                       Visibility="{Binding IsLightboxCompareMode, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                        <components:MaskPainterCanvas x:Name="MagicBrushCanvas"
                                                      Source="{Binding GeneratedImage}"
                                                      BrushSize="{Binding LightboxBrushSize, Mode=TwoWay}"
                                                      IsEraseMode="{Binding IsLightboxBrushErase}"
                                                      MinHeight="320"
                                                      Visibility="{Binding ShowLightboxBrushCanvas, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                        <!-- Floating Scope & Index Badge (Top-Center) -->
                        <Border VerticalAlignment="Top"
                                HorizontalAlignment="Center"
                                Margin="0,12,0,0"
                                Background="{DynamicResource BrushBadgeDark}"
                                BorderBrush="{DynamicResource BrushGoldSubtle}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="14,5"
                                IsHitTestVisible="False"
                                Visibility="{Binding HasLightboxGalleryNavigation, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding LightboxScopeBadge}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                        </Border>

                        <!-- Floating Upscaling Progress Indicator inside Lightbox -->
                        <Border VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,50"
                                Background="{DynamicResource BrushBadgeDark}"
                                BorderBrush="{DynamicResource BrushGold}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,7"
                                IsHitTestVisible="False"
                                Visibility="{Binding LightboxItem.IsUpscaling, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Đang nâng cấp nét Full 2× trên GPU…" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushGold}"/>
                        </Border>

                        <!-- Floating Studio Pro Processing Overlay (2K Hires / Inpaint / Outpaint / RMBG) -->
                        <Border VerticalAlignment="Bottom"
                                HorizontalAlignment="Center"
                                Margin="0,0,0,50"
                                Background="{DynamicResource BrushBadgeDark}"
                                BorderBrush="{DynamicResource BrushGold}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="16,8"
                                IsHitTestVisible="False"
                                Visibility="{Binding IsLightboxProBusy, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="{Binding LightboxProStatusText}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="Bold" Foreground="{DynamicResource BrushGold}"/>
                        </Border>

                        <!-- Floating Left Arrow (Previous Image in Chat or Favorites) -->
                        <Button Command="{Binding PreviousLightboxImageCommand}"
                                Style="{StaticResource LightboxNavButton}"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Margin="14,0,0,36"
                                Visibility="{Binding HasLightboxGalleryNavigation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Ảnh trước (phím ←)"
                                AutomationProperties.Name="Ảnh trước">
                            <Path Data="{StaticResource Icon.ChevronLeft}" Width="22" Height="22" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>

                        <!-- Floating Right Arrow (Next Image in Chat or Favorites) -->
                        <Button Command="{Binding NextLightboxImageCommand}"
                                Style="{StaticResource LightboxNavButton}"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Margin="0,0,14,36"
                                Visibility="{Binding HasLightboxGalleryNavigation, Converter={StaticResource BooleanToVisibilityConverter}}"
                                ToolTip="Ảnh tiếp theo (phím →)"
                                AutomationProperties.Name="Ảnh tiếp theo">
                            <Path Data="{StaticResource Icon.ChevronRight}" Width="22" Height="22" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                    </Grid>

                    <DockPanel Grid.Column="2">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="{DynamicResource Str.Lightbox.Title}" Style="{StaticResource TextSection}" VerticalAlignment="Center"/>
                                <Button Command="{Binding CloseLightboxCommand}" Style="{StaticResource BtnCloseIcon}" HorizontalAlignment="Right" ToolTip="{DynamicResource Str.Common.Close}" AutomationProperties.Name="Đóng (Esc)"/>
                            </Grid>
                            <!-- 3-Mode Studio Pro Tab Switcher -->
                            <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Padding="3">
                                <UniformGrid Columns="3">
                                    <Button Content="{DynamicResource Str.Lightbox.TabDetails}" Command="{Binding SetLightboxToolTabCommand}" CommandParameter="0" Style="{StaticResource BtnPillToggle}" Tag="{Binding LightboxToolTab, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=0}" MinHeight="30" Padding="6,2" FontSize="12"/>
                                    <Button Content="{DynamicResource Str.Lightbox.TabBrush}" Command="{Binding SetLightboxToolTabCommand}" CommandParameter="1" Style="{StaticResource BtnPillToggle}" Tag="{Binding LightboxToolTab, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=1}" MinHeight="30" Padding="4,2" FontSize="11.5"/>
                                    <Button Content="{DynamicResource Str.Lightbox.TabFilm}" Command="{Binding SetLightboxToolTabCommand}" CommandParameter="2" Style="{StaticResource BtnPillToggle}" Tag="{Binding LightboxToolTab, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=2}" MinHeight="30" Padding="6,2" FontSize="12"/>
                                </UniformGrid>
                            </Border>
                        </StackPanel>

                        <!-- Pinned Bottom Export & Quick Actions -->
                        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0">
                            <Button Content="{Binding LightboxCompareButtonLabel}"
                                    Command="{Binding ToggleLightboxCompareCommand}"
                                    Style="{StaticResource BtnSecondary}"
                                    Height="34"
                                    Margin="0,0,0,6"
                                    Visibility="{Binding CanCompareLightbox, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Button Command="{Binding SaveCanvasImageCommand}" Style="{StaticResource DreaminaPillButton}" Height="38" Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Path Data="{StaticResource Icon.Download}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,7,0"/>
                                    <TextBlock Text="{DynamicResource Str.Lightbox.DownloadPng}" Foreground="{DynamicResource BrushOnEmerald}" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Command="{Binding CopyCanvasImageCommand}" Style="{StaticResource BtnSecondary}" Height="34" Padding="10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="{StaticResource Icon.Copy}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.CopyImage}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="2" Content="{Binding LightboxFavoriteLabel}" Command="{Binding ToggleFavoriteImageCommand}" Style="{StaticResource BtnSecondary}" Foreground="{DynamicResource BrushGold}" Height="34" Padding="12,0" FontSize="{DynamicResource FontSizeSmall}" Visibility="{Binding HasLightboxItem, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            </Grid>
                        </StackPanel>

                        <!-- Tab 0: Details, 2K Tiled Hires-Fix, 1-Click Background Removal & Prompt -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLightboxDetailsTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,10">
                                    <TextBlock Text="{Binding LightboxMetaSummary}" Style="{StaticResource TextCaption}" TextWrapping="Wrap"/>
                                </Border>

                                <!-- 2K Hires-Fix + Remove Background Studio Pro Box -->
                                <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.ProTitle}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Str.Lightbox.HiresDenoise}" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HiresDenoise, StringFormat={}{0:0.00}}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushGold}"/>
                                        </Grid>
                                        <Slider Minimum="0.14" Maximum="0.38" SmallChange="0.02" Value="{Binding HiresDenoise}" Margin="0,0,0,8" ToolTip="0.20–0.26 recommended for 2K skin/hair/fabric detail"/>
                                        <Button Command="{Binding HiresFixLightboxImageCommand}" Style="{StaticResource BtnPrimary}" Height="34" Margin="0,0,0,6" ToolTip="4x_NMKD-Siax + Tiled Z-Image-Turbo 2K">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Str.Lightbox.HiresFix2K}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="6"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="{DynamicResource Str.Lightbox.Upscale2xFast}" Command="{Binding UpscaleTurnImageCommand}" Style="{StaticResource BtnSecondary}" Height="32" Padding="6,0" FontSize="12" Visibility="{Binding LightboxItem.CanUpscale, FallbackValue=Collapsed, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                            <Button Grid.Column="2" Content="{DynamicResource Str.Lightbox.RemoveBgPng}" Command="{Binding RemoveBackgroundLightboxCommand}" Style="{StaticResource BtnSecondary}" Height="32" Padding="6,0" FontSize="12" ToolTip="Bria RMBG-1.4 transparent alpha cutout (CPU · 0 VRAM)"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Margin="0,0,0,10" Visibility="{Binding HasLightboxItem, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{DynamicResource Str.Lightbox.LockSeed}" Command="{Binding UseLastSeedCommand}" Style="{StaticResource BtnSecondary}" Height="32" Padding="8,0" FontSize="12"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Str.Lightbox.ReusePrompt}" Command="{Binding ReuseSessionPromptCommand}" Style="{StaticResource BtnSecondary}" Height="32" Padding="8,0" FontSize="12"/>
                                </Grid>

                                <TextBlock Text="{DynamicResource Str.Lightbox.UsedPrompt}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding LightboxPrompt, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalContentAlignment="Top" Padding="10,8" MinHeight="96" MaxHeight="200" VerticalScrollBarVisibility="Auto" Background="{DynamicResource BrushCanvas}"/>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab 1: Magic Brush Inpainting & Canvas Outpainting (Union 2.1) -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLightboxMagicBrushTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.BrushTitle}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.BrushHint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                        <CheckBox Content="{DynamicResource Str.Lightbox.BrushEraseMode}" IsChecked="{Binding IsLightboxBrushErase}" FontSize="12" Margin="0,0,0,8"/>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.BrushPromptLabel}" Style="{StaticResource TextCaption}" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                        <TextBox Text="{Binding InpaintPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="64" MaxHeight="110" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="{DynamicResource Str.Lightbox.BrushControlStrength}" Style="{StaticResource TextCaption}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding InpaintControlStrength, StringFormat={}{0:0.00}}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource BrushGold}"/>
                                        </Grid>
                                        <Slider Minimum="0.50" Maximum="1.15" SmallChange="0.05" Value="{Binding InpaintControlStrength}" Margin="0,0,0,8"/>
                                        <Button Command="{Binding RunInpaintLightboxCommand}" Style="{StaticResource BtnPrimary}" Height="36">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                                                <TextBlock Text="{DynamicResource Str.Lightbox.BrushRunInpaint}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderStrong}" BorderThickness="1" CornerRadius="12" Padding="10">
                                    <StackPanel>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.OutpaintTitle}" FontSize="12.5" FontWeight="Bold" Margin="0,0,0,4"/>
                                        <TextBlock Text="{DynamicResource Str.Lightbox.OutpaintHint}" Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                        <TextBox Text="{Binding OutpaintPrompt, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="48" MaxHeight="84" VerticalContentAlignment="Top" Padding="8,6" VerticalScrollBarVisibility="Auto" Margin="0,0,0,8"/>
                                        <UniformGrid Columns="2">
                                            <Button Content="{DynamicResource Str.Lightbox.Outpaint16x9}" Command="{Binding RunOutpaintLightboxCommand}" CommandParameter="16:9" Style="{StaticResource BtnSecondary}" Height="32" Margin="0,0,4,6" FontSize="12"/>
                                            <Button Content="{DynamicResource Str.Lightbox.Outpaint1x1}" Command="{Binding RunOutpaintLightboxCommand}" CommandParameter="1:1" Style="{StaticResource BtnSecondary}" Height="32" Margin="4,0,0,6" FontSize="12"/>
                                            <Button Content="{DynamicResource Str.Lightbox.Outpaint3x4}" Command="{Binding RunOutpaintLightboxCommand}" CommandParameter="3:4" Style="{StaticResource BtnSecondary}" Height="32" Margin="0,0,4,6" FontSize="12"/>
                                            <Button Content="{DynamicResource Str.Lightbox.OutpaintExpand25}" Command="{Binding RunOutpaintLightboxCommand}" CommandParameter="expand25" Style="{StaticResource BtnSecondary}" Height="32" Margin="4,0,0,6" FontSize="12"/>
                                            <Button Content="{DynamicResource Str.Lightbox.OutpaintLeft}" Command="{Binding RunOutpaintLightboxCommand}" CommandParameter="left" Style="{StaticResource BtnGhost}" Height="30" Margin="0,0,4,0" FontSize="12"/>
                                            <Button Content="{DynamicResource Str.Lightbox.OutpaintRight}" Command="{Binding RunOutpaintLightboxCommand}" CommandParameter="right" Style="{StaticResource BtnGhost}" Height="30" Margin="4,0,0,0" FontSize="12"/>
                                        </UniformGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>

                        <!-- Tab 2: 0-GPU Real-time Film Color Grading & 35mm Grain -->
                        <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsLightboxColorGradeTab, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource Str.Lightbox.FilmTitle}" FontSize="12" FontWeight="Bold" Margin="0,0,0,6"/>
                                <ItemsControl ItemsSource="{Binding AvailableFilmPresets}" Margin="0,0,0,10">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding LocalizedLabel}" Command="{Binding DataContext.SelectFilmPresetCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Style="{StaticResource BtnPillToggle}" MinHeight="28" Padding="9,2" FontSize="11.5" Margin="0,0,5,5">
                                                <Button.Tag>
                                                    <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                        <Binding Path="Key"/>
                                                        <Binding Path="DataContext.SelectedFilmPresetKey" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                    </MultiBinding>
                                                </Button.Tag>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="10" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeExposure}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding GradeExposure, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="-0.5" Maximum="0.5" SmallChange="0.02" Value="{Binding GradeExposure}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeContrast}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding GradeContrast, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="-0.4" Maximum="0.5" SmallChange="0.02" Value="{Binding GradeContrast}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeSaturation}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding GradeSaturation, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="-1.0" Maximum="0.7" SmallChange="0.04" Value="{Binding GradeSaturation}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeWarmth}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding GradeWarmth, StringFormat={}{0:+0.00;-0.00;0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="-0.5" Maximum="0.5" SmallChange="0.02" Value="{Binding GradeWarmth}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeClarity}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding GradeClarity, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.04" Value="{Binding GradeClarity}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeFilmGrain}" Style="{StaticResource TextCaption}" FontWeight="SemiBold"/><TextBlock Text="{Binding GradeFilmGrain, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="0.0" Maximum="1.0" SmallChange="0.04" Value="{Binding GradeFilmGrain}" Margin="0,0,0,6"/>

                                        <Grid Margin="0,0,0,2"><TextBlock Text="{DynamicResource Str.Lightbox.GradeVignette}" Style="{StaticResource TextCaption}"/><TextBlock Text="{Binding GradeVignette, StringFormat={}{0:0.00}}" HorizontalAlignment="Right" FontSize="11" Foreground="{DynamicResource BrushGold}"/></Grid>
                                        <Slider Minimum="0.0" Maximum="0.8" SmallChange="0.04" Value="{Binding GradeVignette}"/>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="6"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Content="{DynamicResource Str.Lightbox.GradeCommit}" Command="{Binding CommitColorGradeCommand}" Style="{StaticResource BtnPrimary}" Height="34" FontSize="12.5"/>
                                    <Button Grid.Column="2" Content="{DynamicResource Str.Lightbox.GradeReset}" Command="{Binding ResetColorGradeCommand}" Style="{StaticResource BtnSecondary}" Height="34" Padding="12,0" FontSize="12"/>
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
