<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Features.Views.ProjectsView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Dự án của tôi" Style="{StaticResource TextPageTitle}"/>
                <TextBlock Text="Không gian làm việc của bạn và những người cộng tác." Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="Tạo dự án" Command="{Binding OpenCreateProjectDialogCommand}" Style="{StaticResource BtnPrimary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Grid>
                <TextBox x:Name="ProjectSearchBox" Text="{Binding ProjectSearchText, UpdateSourceTrigger=PropertyChanged, Delay=300}" AutomationProperties.Name="Tìm kiếm dự án" ToolTip="Tìm theo tên hoặc mô tả dự án · Ctrl+F" Margin="0,0,12,0"/>
                <TextBlock Text="Tìm tên hoặc mô tả dự án…" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,24,0" IsHitTestVisible="False" Focusable="False">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ProjectSearchText}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <ComboBox Grid.Column="1" SelectedItem="{Binding ProjectStatusFilter}" ItemsSource="{Binding ProjectStatusFilters}" AutomationProperties.Name="Lọc trạng thái dự án" Margin="0,0,12,0"/>
            <ComboBox Grid.Column="2" SelectedItem="{Binding ProjectSort}" ItemsSource="{Binding ProjectSortOptions}" AutomationProperties.Name="Sắp xếp dự án" Margin="0,0,12,0"/>
            <StackPanel Grid.Column="3" Orientation="Horizontal">
                <Button Content="Lưới" Command="{Binding SetProjectViewCommand}" CommandParameter="Grid" Style="{StaticResource BtnSecondary}" Margin="0,0,4,0" AutomationProperties.Name="Xem dự án dạng lưới"/>
                <Button Content="Bảng" Command="{Binding SetProjectViewCommand}" CommandParameter="List" Style="{StaticResource BtnSecondary}" AutomationProperties.Name="Xem dự án dạng bảng"/>
                <Button Command="{Binding RefreshProjectsCommand}" Style="{StaticResource BtnIcon}" Margin="8,0,0,0" ToolTip="Làm mới dự án" AutomationProperties.Name="Làm mới dự án">
                    <Path Data="{StaticResource Icon.RefreshCw}" Style="{StaticResource LucideIconSmall}"/>
                </Button>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="2">
            <ListBox x:Name="ProjectCards" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProject}" Visibility="{Binding IsProjectListView, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="Projects_Open" PreviewKeyDown="Projects_KeyDown" PreviewMouseRightButtonDown="SelectContextItem" AutomationProperties.Name="Dự án dạng lưới">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="2"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="ItemBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="12">
                                        <ContentPresenter/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushAccent}"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="{DynamicResource BrushHover}"/>
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                            <Setter Property="BorderBrush" Value="{DynamicResource BrushFocus}"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Width="248" Margin="0,0,16,16" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="10" Background="{DynamicResource BrushSurface}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="148"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Border Background="{DynamicResource BrushCardElevated}" CornerRadius="9,9,0,0">
                                    <Grid>
                                        <Path Data="M0,20 L20,0 40,20 20,40 Z M20,0 L20,40 M0,20 L40,20" Stroke="{DynamicResource BrushBorderStrong}" StrokeThickness="1.3" Width="80" Height="80" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ProjectType}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11" Margin="14" VerticalAlignment="Bottom"/>
                                        <Button Content="…" Click="ProjectMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource BtnSecondary}" Width="32" Height="30" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" ToolTip="Thao tác với dự án" AutomationProperties.Name="Thao tác với dự án"/>
                                    </Grid>
                                </Border>
                                <StackPanel Grid.Row="1" Margin="16,14">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}"/>
                                    <Grid Margin="0,8,0,0">
                                        <TextBlock Text="{Binding Status, Converter={StaticResource StatusTextConverter}}" FontSize="12" Foreground="{DynamicResource BrushTextMuted}"/>
                                        <TextBlock Text="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='Mới tạo'}" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource BrushTextMuted}"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <DataGrid x:Name="ProjectTable" ItemsSource="{Binding FilteredProjects}" SelectedItem="{Binding SelectedProject}" Visibility="{Binding IsProjectListView, Converter={StaticResource BooleanToVisibilityConverter}}" IsReadOnly="True" AutoGenerateColumns="False" MouseDoubleClick="Projects_Open" PreviewKeyDown="Projects_KeyDown" PreviewMouseRightButtonDown="SelectContextItem" AutomationProperties.Name="Dự án dạng bảng">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên dự án" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="Loại" Binding="{Binding ProjectType}" Width="100"/>
                    <DataGridTextColumn Header="Trạng thái" Binding="{Binding Status, Converter={StaticResource StatusTextConverter}}" Width="150"/>
                    <DataGridTextColumn Header="Cập nhật" Binding="{Binding UpdatedAt, StringFormat='{}{0:dd/MM/yyyy}', TargetNullValue='Mới tạo'}" Width="112"/>
                    <DataGridTemplateColumn Width="48">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="…" Click="ProjectMenu_Click" Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}" Style="{StaticResource BtnGhost}" Width="32" ToolTip="Thao tác với dự án" AutomationProperties.Name="Thao tác với dự án" Padding="0"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="360" Margin="24">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Projects.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="{Binding ProjectEmptyTitle}" Style="{StaticResource TextSection}" TextAlignment="Center"/>
                <TextBlock Text="{Binding ProjectEmptyDescription}" Style="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,20"/>
                <WrapPanel HorizontalAlignment="Center">
                    <Button Content="Tạo dự án" Command="{Binding OpenCreateProjectDialogCommand}" Style="{StaticResource BtnPrimary}" Margin="0,0,8,0"/>
                    <Button Content="Xóa bộ lọc" Command="{Binding ClearProjectFiltersCommand}" Style="{StaticResource BtnSecondary}"/>
                </WrapPanel>
            </StackPanel>
        </Grid>
        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <Button Content="Mở dự án đã chọn" Command="{Binding OpenProjectCommand}" CommandParameter="{Binding SelectedProject}" Style="{StaticResource BtnSecondary}"/>
                <Button Content="Chỉnh sửa" Command="{Binding OpenEditProjectCommand}" CommandParameter="{Binding SelectedProject}" Style="{StaticResource BtnGhost}" Margin="8,0,0,0"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Trước" Command="{Binding PreviousProjectPageCommand}" Style="{StaticResource BtnGhost}"/>
                <TextBlock Text="{Binding ProjectPageLabel}" VerticalAlignment="Center" Margin="12,0" Style="{StaticResource TextCaption}"/>
                <Button Content="Sau" Command="{Binding NextProjectPageCommand}" Style="{StaticResource BtnGhost}"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
