<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Features.Views.ProjectTeamView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Dự án và thành viên" Style="{StaticResource TextPageTitle}"/>
                <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="Chỉnh sửa dự án" Command="{Binding OpenEditProjectCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <TabControl Grid.Row="1" AutomationProperties.Name="Thành viên và thiết lập dự án">
            <TabItem Header="Thành viên">
                <Grid Margin="4,20,4,4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <DataGrid ItemsSource="{Binding ProjectMembers}" SelectedItem="{Binding SelectedProjectMember}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Thành viên dự án">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Thành viên" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                            <DataGridTextColumn Header="Quyền" Binding="{Binding Role, Converter={StaticResource StatusTextConverter}}" Width="110"/>
                            <DataGridTextColumn Header="Ngày tham gia" Binding="{Binding JoinedAt, StringFormat='{}{0:dd/MM/yyyy}'}" Width="110"/>
                            <DataGridTemplateColumn Header="" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Gỡ" Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnGhost}" Foreground="{DynamicResource BrushNegative}" IsEnabled="{Binding DataContext.CanManageProject, RelativeSource={RelativeSource AncestorType=UserControl}}" ToolTip="Gỡ thành viên khỏi dự án"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20" Margin="0,20,0,0">
                        <StackPanel>
                            <Grid IsEnabled="{Binding CanManageProject}" Margin="0,0,0,20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <TextBlock Text="Thành viên đang chọn" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding SelectedProjectMember.Email}" Style="{StaticResource TextCaption}" Margin="0,6,0,0"/>
                                </StackPanel>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding MemberRoleOptions}" SelectedItem="{Binding SelectedMemberRole}" AutomationProperties.Name="Quyền mới của thành viên đã chọn" Margin="0,0,12,0">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Converter={StaticResource StatusTextConverter}}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2" Content="Đổi quyền" Command="{Binding ChangeMemberRoleCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                                <Button Grid.Column="3" Content="Chuyển chủ dự án" Command="{Binding TransferOwnershipCommand}" Style="{StaticResource BtnGhost}"/>
                            </Grid>
                            <TextBlock Text="Thêm tài khoản đã tồn tại" Style="{StaticResource TextSection}"/>
                            <TextBlock Text="Chỉ quản trị viên hệ thống có thể tạo tài khoản mới." Style="{StaticResource TextCaption}" Margin="0,6,0,16"/>
                            <Grid IsEnabled="{Binding CanManageProject}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="16"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Email tài khoản" Style="{StaticResource TextBody}"/>
                                        <TextBox Text="{Binding NewMemberEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email tài khoản"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <StackPanel Margin="0,0,0,16">
                                        <TextBlock Text="Quyền trong dự án" Style="{StaticResource TextBody}"/>
                                        <ComboBox ItemsSource="{Binding AvailableMemberRoles}" SelectedItem="{Binding NewMemberRole}" AutomationProperties.Name="Quyền trong dự án"/>
                                    </StackPanel>
                                </StackPanel>
                                <Button Grid.Column="4" Content="Thêm thành viên" Command="{Binding AddMemberCommand}" Style="{StaticResource BtnPrimary}" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
            <TabItem Header="Thông tin dự án">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="4,20,16,16">
                        <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource TextSection}"/>
                        <TextBlock Text="{Binding SelectedProject.Description}" TextWrapping="Wrap" Style="{StaticResource TextSecondary}" Margin="0,12,0,20"/>
                        <TextBlock Text="{Binding SelectedProject.ProjectType, StringFormat='{}Loại dự án: {0}'}" Style="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding SelectedProject.Status, StringFormat='{}Trạng thái: {0}'}" Style="{StaticResource TextSecondary}" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding SelectedProject.CreatedAt, StringFormat='{}Ngày tạo: {0:dd/MM/yyyy}'}" Style="{StaticResource TextCaption}"/>
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,28,0,20"/>
                        <TextBlock Text="Lưu trữ dự án" Style="{StaticResource TextSection}"/>
                        <TextBlock Text="Nội dung vẫn được giữ lại sau khi lưu trữ. Máy chủ sẽ hạn chế các thay đổi trong dự án." TextWrapping="Wrap" Style="{StaticResource TextSecondary}" Margin="0,8,0,20"/>
                        <WrapPanel IsEnabled="{Binding CanManageProject}">
                            <Button Content="Lưu trữ dự án" Command="{Binding ArchiveProjectCommand}" Style="{StaticResource BtnDanger}" Margin="0,0,8,0"/>
                            <Button Content="Khôi phục dự án" Command="{Binding RestoreProjectCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                        </WrapPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
