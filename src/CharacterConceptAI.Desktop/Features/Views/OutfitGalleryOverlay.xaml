<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CharacterConceptAI.Desktop.Features.Views.OutfitGalleryOverlay">
    <Grid Background="{DynamicResource BrushOverlay}"
          MouseLeftButtonDown="OutfitGalleryBackdrop_MouseDown"
          Visibility="{Binding IsOutfitGalleryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource BrushBorderStrong}" CornerRadius="20" Margin="28" Padding="20" MaxWidth="1360" MaxHeight="840">
            <DockPanel>
                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding OutfitGalleryTargetTitle}" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSelected}" CornerRadius="11" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding OutfitGalleryStatsLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSelected}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="{DynamicResource Str.Outfit.Subtitle}" Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <CheckBox Content="{DynamicResource Str.Outfit.Unlock18}"
                                  IsChecked="{Binding OutfitGalleryIncludeNsfw}"
                                  Visibility="{Binding AllowNsfwContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Margin="0,0,12,0"
                                  ToolTip="{DynamicResource Str.Outfit.Unlock18}"
                                  AutomationProperties.Name="Mở khóa 18+ kho trang phục"/>
                        <Button Command="{Binding CloseOutfitGalleryCommand}" Style="{StaticResource BtnCloseIcon}" ToolTip="{DynamicResource Str.Common.Close}" AutomationProperties.Name="Đóng kho trang phục"/>
                    </StackPanel>
                </Grid>

                <!-- Search & Filters -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="290"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="OutfitSearchBox" Text="{Binding OutfitGallerySearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Padding="28,4,10,4"/>
                            <Path Data="{StaticResource Icon.Search}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="{DynamicResource Str.Outfit.SearchPlaceholder}" Foreground="{DynamicResource BrushTextMuted}" FontSize="12" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False" TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=OutfitSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding OutfitGalleryCollections}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding OutfitGalleryCollectionFilter, Mode=TwoWay}" MinHeight="34" ToolTip="Collection"/>

                        <!-- Gender Quick Pills -->
                        <ItemsControl Grid.Column="4" ItemsSource="{Binding OutfitGalleryGenders}" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Command="{Binding DataContext.SetOutfitGalleryGenderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Style="{StaticResource BtnPillToggle}" MinHeight="32" Padding="12,2" FontSize="12" Margin="0,0,6,0">
                                        <Button.Tag>
                                            <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                <Binding Path="Key"/>
                                                <Binding Path="DataContext.OutfitGalleryGenderFilter" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                            </MultiBinding>
                                        </Button.Tag>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Margin="0,0,5,0"/>
                                            <TextBlock Text="{Binding Count, StringFormat=({0})}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                        </StackPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Grid.Column="5" Content="{DynamicResource Str.Outfit.Reset}" Command="{Binding ResetOutfitGalleryFiltersCommand}" Style="{StaticResource BtnGhost}" MinHeight="34" Padding="10,4" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- Category Quick Pills -->
                    <ItemsControl ItemsSource="{Binding OutfitGalleryCategories}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SetOutfitGalleryCategoryCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Style="{StaticResource BtnPillToggle}" MinHeight="28" Padding="10,2" FontSize="12" Margin="0,0,6,2">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                            <Binding Path="Key"/>
                                            <Binding Path="DataContext.OutfitGalleryCategoryFilter" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Count, StringFormat=({0})}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Pagination Footer -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="{Binding OutfitGalleryPageLabel}" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PreviousOutfitGalleryPageCommand}" IsEnabled="{Binding HasPreviousOutfitPage}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.ArrowLeft}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                <TextBlock Text="{DynamicResource Str.Outfit.PrevPage}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NextOutfitGalleryPageCommand}" IsEnabled="{Binding HasNextOutfitPage}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="{DynamicResource Str.Outfit.NextPage}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Path Data="{StaticResource Icon.ArrowRight}" Style="{StaticResource LucideIconSmall}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Outfit Cards Grid -->
                <Grid>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Panel.ZIndex="10"
                            Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="1" CornerRadius="10" Padding="12,4"
                            Visibility="{Binding IsOutfitGalleryLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Str.Outfit.Loading}" FontSize="12" Foreground="{DynamicResource BrushGold}" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding IsOutfitGalleryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="{DynamicResource Str.Outfit.EmptyTitle}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="{DynamicResource Str.Outfit.EmptyHint}" Style="{StaticResource TextSecondary}" Margin="0,6,0,14" HorizontalAlignment="Center"/>
                        <Button Content="{DynamicResource Str.Outfit.ResetFilters}" Command="{Binding ResetOutfitGalleryFiltersCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer x:Name="OutfitCardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding OutfitGalleryItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="206" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Margin="0,0,12,12" Padding="8">
                                        <StackPanel>
                                            <Button Command="{Binding DataContext.ApplyOutfitGalleryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand">
                                                <Border Height="234" Width="188" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}">
                                                    <Grid>
                                                        <TextBlock Text="{DynamicResource Str.Outfit.LoadingImg}" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoadingImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6" Background="{DynamicResource BrushBadgeDark}" CornerRadius="8" Padding="7,2">
                                                            <TextBlock Text="{Binding Code}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6" Background="{DynamicResource BrushBadgeEmerald}" BorderBrush="#000000" BorderThickness="0.8" CornerRadius="8" Padding="7,2">
                                                            <TextBlock Text="{Binding CategoryLabel}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}" MaxWidth="105" TextTrimming="CharacterEllipsis"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Background="{DynamicResource BrushBadgeEmerald}" BorderBrush="#000000" BorderThickness="0.8" CornerRadius="8" Padding="7,2" Visibility="{Binding ShowTopQualityBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Background="{DynamicResource BrushBadgeDark}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="0.8" CornerRadius="8" Padding="7,2" Visibility="{Binding ShowLowQualityBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="6" Background="{DynamicResource BrushBadgeDark}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="0.7" CornerRadius="7" Padding="6,2">
                                                            <TextBlock Text="{Binding GenderLabel}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,7,2,2" ToolTip="{Binding DisplayName}"/>
                                            <TextBlock Text="{Binding TagsSummary}" Style="{StaticResource TextCaption}" FontSize="10.5" TextTrimming="CharacterEllipsis" Margin="2,0,2,6" ToolTip="{Binding TagsSummary}"/>

                                            <!-- Multi-angle switcher (visible for 4-angle outfits) -->
                                            <ItemsControl ItemsSource="{Binding Views}" Margin="0,0,0,7" Visibility="{Binding HasMultipleViews, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding ViewLabel}" Command="{Binding DataContext.SwitchOutfitCardViewCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnPillToggle}" Tag="{Binding IsActive, Converter={StaticResource BoolToSelectedTagConverter}}" MinHeight="22" Padding="5,1" FontSize="10" Margin="0,0,3,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Command="{Binding DataContext.ApplyOutfitGalleryItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnPrimary}" MinHeight="30" Padding="8,2" FontSize="12">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.Shirt}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="{DynamicResource Str.Outfit.SelectThis}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
