<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CharacterConceptAI.Desktop.Features.Views.PoseGalleryOverlay">
    <Grid Background="{DynamicResource BrushOverlay}"
          MouseLeftButtonDown="PoseGalleryBackdrop_MouseDown"
          Visibility="{Binding IsPoseGalleryOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
        <Border Style="{StaticResource Card}" BorderBrush="{DynamicResource BrushBorderStrong}" CornerRadius="20" Margin="28" Padding="20" MaxWidth="1360" MaxHeight="840">
            <DockPanel>
                <!-- Header -->
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,12,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding PoseGalleryTargetTitle}" FontSize="{DynamicResource FontSizeSection}" FontWeight="Bold" TextTrimming="CharacterEllipsis" MaxWidth="560" Margin="0,0,10,0"/>
                            <Border Grid.Column="1" Background="{DynamicResource BrushSelected}" CornerRadius="11" Padding="10,3" VerticalAlignment="Center">
                                <TextBlock Text="{Binding PoseGalleryStatsLabel}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnSelected}"/>
                            </Border>
                        </Grid>
                        <TextBlock Text="Xếp từ trên xuống theo độ chuẩn cao nhất (Chuẩn nhất ở đầu) · Tự đồng bộ tư thế &amp; góc máy với prompt." Style="{StaticResource TextCaption}" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="{Binding PoseGalleryModeLabel}" Command="{Binding TogglePoseGalleryPreviewModeCommand}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4" FontSize="12" Margin="0,0,10,0" ToolTip="Chuyển chế độ xem giữa Ma-nơ-canh 3D và Bản đồ sâu Depth"/>
                        <CheckBox Content="Mở khóa 18+"
                                  IsChecked="{Binding PoseGalleryIncludeNsfw}"
                                  Visibility="{Binding AllowNsfwContent, Converter={StaticResource BooleanToVisibilityConverter}}"
                                  VerticalAlignment="Center"
                                  FontSize="12"
                                  Margin="0,0,12,0"
                                  ToolTip="Chỉ hiển thị khi đã bật quyền 18+ (NSFW) trong Cài đặt"
                                  AutomationProperties.Name="Mở khóa 18+ kho dáng"/>
                        <Button Command="{Binding ClosePoseGalleryCommand}" Style="{StaticResource BtnCloseIcon}" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng kho dáng"/>
                    </StackPanel>
                </Grid>

                <!-- Search & Filters -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="210"/>
                            <ColumnDefinition Width="10"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0">
                            <TextBox x:Name="PoseSearchBox" Text="{Binding PoseGallerySearchText, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" Padding="28,4,10,4"/>
                            <Path Data="{StaticResource Icon.Search}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BrushTextMuted}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                            <TextBlock Text="Tìm dáng (VD: đứng, ngồi, P001…)" Foreground="{DynamicResource BrushTextMuted}" FontSize="12.5" Margin="29,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=PoseSearchBox}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox Grid.Column="2" ItemsSource="{Binding PoseGalleryCategories}" SelectedValuePath="Key" DisplayMemberPath="Label" SelectedValue="{Binding PoseGalleryCategoryFilter, Mode=TwoWay}" MinHeight="34" ToolTip="Lọc theo thể loại tư thế"/>

                        <ScrollViewer Grid.Column="4" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding PoseGalleryAngles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding Label}" Command="{Binding DataContext.SetPoseGalleryAngleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Style="{StaticResource BtnPillToggle}" MinHeight="30" Padding="10,2" FontSize="12" Margin="0,0,6,0">
                                            <Button.Tag>
                                                <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                                    <Binding Path="Key"/>
                                                    <Binding Path="DataContext.PoseGalleryAngleFilter" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                </MultiBinding>
                                            </Button.Tag>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <Button Grid.Column="5" Content="Đặt lại" Command="{Binding ResetPoseGalleryFiltersCommand}" Style="{StaticResource BtnGhost}" MinHeight="34" Padding="10,4" Margin="8,0,0,0"/>
                    </Grid>

                    <!-- System Pills -->
                    <ItemsControl ItemsSource="{Binding PoseGallerySystems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Command="{Binding DataContext.SetPoseGallerySystemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding Key}" Style="{StaticResource BtnPillToggle}" MinHeight="28" Padding="10,2" FontSize="12" Margin="0,0,6,2">
                                    <Button.Tag>
                                        <MultiBinding Converter="{StaticResource EqualsToSelectedTagConverter}">
                                            <Binding Path="Key"/>
                                            <Binding Path="DataContext.PoseGallerySystemFilter" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                        </MultiBinding>
                                    </Button.Tag>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Label}" Margin="0,0,5,0"/>
                                        <TextBlock Text="{Binding Count, StringFormat=({0})}" Foreground="{DynamicResource BrushTextMuted}" FontSize="11"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>

                <!-- Pagination Footer -->
                <Grid DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <TextBlock Text="{Binding PoseGalleryPageLabel}" Style="{StaticResource TextCaption}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Command="{Binding PreviousPoseGalleryPageCommand}" IsEnabled="{Binding HasPreviousPosePage}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4" Margin="0,0,8,0">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.ArrowLeft}" Style="{StaticResource LucideIconSmall}" Margin="0,0,6,0"/>
                                <TextBlock Text="Trang trước" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding NextPoseGalleryPageCommand}" IsEnabled="{Binding HasNextPosePage}" Style="{StaticResource BtnSecondary}" MinHeight="34" Padding="12,4">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="Trang sau" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Path Data="{StaticResource Icon.ArrowRight}" Style="{StaticResource LucideIconSmall}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Cards Grid -->
                <Grid>
                    <Border HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,6,0,0" Panel.ZIndex="10"
                            Background="{DynamicResource BrushCardElevated}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="1" CornerRadius="10" Padding="12,4"
                            Visibility="{Binding IsPoseGalleryLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Đang nạp kho dáng 3D…" FontSize="12" Foreground="{DynamicResource BrushGold}" FontWeight="SemiBold"/>
                    </Border>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" Visibility="{Binding IsPoseGalleryEmpty, Converter={StaticResource BooleanToVisibilityConverter}}">
                        <TextBlock Text="Không tìm thấy tư thế phù hợp" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="Hãy thử từ khóa ngắn hơn (VD: đứng, ngồi, P001) hoặc bấm Đặt lại bộ lọc." Style="{StaticResource TextSecondary}" Margin="0,6,0,14" HorizontalAlignment="Center"/>
                        <Button Content="Đặt lại bộ lọc" Command="{Binding ResetPoseGalleryFiltersCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Center"/>
                    </StackPanel>
                    <ScrollViewer x:Name="PoseCardsScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding PoseGalleryGroups}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Width="206" Background="{DynamicResource BrushCanvas}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="1" CornerRadius="14" Margin="0,0,12,12" Padding="8">
                                        <StackPanel>
                                            <Button Command="{Binding DataContext.ApplyPoseGalleryGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="Transparent" BorderThickness="0" Padding="0" Cursor="Hand" ToolTip="Nhấn để chọn tư thế &amp; góc máy này">
                                                <Border Height="214" Width="188" CornerRadius="10" ClipToBounds="True" Background="{DynamicResource BrushCardElevated}">
                                                    <Grid>
                                                        <TextBlock Text="Đang tải…" FontSize="11.5" Foreground="{DynamicResource BrushTextMuted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsLoadingImage, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                                                        <Image Source="{Binding PreviewImage}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Left" Margin="6" Background="{DynamicResource BrushBadgeDark}" CornerRadius="8" Padding="7,2">
                                                            <TextBlock Text="{Binding PoseCode}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Top" HorizontalAlignment="Right" Margin="6" Background="{DynamicResource BrushBadgeEmerald}" BorderBrush="#000000" BorderThickness="0.8" CornerRadius="8" Padding="7,2">
                                                            <TextBlock Text="{Binding ActiveAngleLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Background="{DynamicResource BrushBadgeEmerald}" BorderBrush="#000000" BorderThickness="0.8" CornerRadius="8" Padding="7,2" Visibility="{Binding ShowTopQualityBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}"/>
                                                        </Border>
                                                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="6" Background="{DynamicResource BrushBadgeDark}" BorderBrush="{DynamicResource BrushGold}" BorderThickness="0.8" CornerRadius="8" Padding="7,2" Visibility="{Binding ShowHardPoseBadge, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                            <TextBlock Text="{Binding QualityBadge}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource BrushOnBadgeDark}"/>
                                                        </Border>
                                                    </Grid>
                                                </Border>
                                            </Button>

                                            <TextBlock Text="{Binding NameVi}" FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="2,7,2,2" ToolTip="{Binding NameVi}"/>
                                            <TextBlock Text="{Binding CategoryLabel}" Style="{StaticResource TextCaption}" FontSize="11" Margin="2,0,2,6"/>

                                            <!-- 5 Camera Angles Quick Switch with Active Highlight -->
                                            <ItemsControl ItemsSource="{Binding Angles}" Margin="0,0,0,7">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Button Content="{Binding AngleLabel}" Command="{Binding DataContext.SwitchPoseCardAngleCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnPillToggle}" Tag="{Binding IsActive, Converter={StaticResource BoolToSelectedTagConverter}}" MinHeight="22" Padding="5,1" FontSize="10.5" Margin="0,0,3,3"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <Button Command="{Binding DataContext.ApplyPoseGalleryGroupCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Style="{StaticResource BtnPrimary}" MinHeight="30" Padding="8,2" FontSize="12">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,6,0"/>
                                                    <TextBlock Text="Chọn tư thế này" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
