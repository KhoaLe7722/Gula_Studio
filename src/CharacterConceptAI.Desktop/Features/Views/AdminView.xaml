<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="CharacterConceptAI.Desktop.Features.Views.AdminView">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid Margin="0,0,0,24">
            <StackPanel>
                <TextBlock Text="Quản trị tài khoản" Style="{StaticResource TextPageTitle}"/>
                <TextBlock Text="Tạo tài khoản nội bộ và quản lý quyền truy cập hệ thống." Style="{StaticResource TextSecondary}" Margin="0,6,0,0"/>
            </StackPanel>
            <Button Content="Làm mới" Command="{Binding LoadAccountsCommand}" Style="{StaticResource BtnSecondary}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>
            <DataGrid ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" AutoGenerateColumns="False" IsReadOnly="True" AutomationProperties.Name="Danh sách tài khoản">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Tên hiển thị" Binding="{Binding DisplayName}" Width="*"/>
                    <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
                    <DataGridCheckBoxColumn Header="Hoạt động" Binding="{Binding IsActive}" Width="90"/>
                </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="20">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Tạo tài khoản" Style="{StaticResource TextSection}" Margin="0,0,0,20"/>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Tên hiển thị" Style="{StaticResource TextBody}"/>
                            <TextBox Text="{Binding AccountDisplayName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Tên hiển thị"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,16">
                            <TextBlock Text="Email tài khoản" Style="{StaticResource TextBody}"/>
                            <TextBox Text="{Binding AccountEmail, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Email tài khoản"/>
                        </StackPanel>
                        <TextBlock Text="Mật khẩu ban đầu" Margin="0,0,0,8"/>
                        <PasswordBox x:Name="NewAccountPassword" AutomationProperties.Name="Mật khẩu ban đầu của tài khoản mới" Margin="0,0,0,20"/>
                        <Button Content="Tạo tài khoản" Click="CreateAccount_Click" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BtnPrimary}"/>
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="0,24,0,20"/>
                        <TextBlock Text="Tài khoản đang chọn" Style="{StaticResource TextSection}"/>
                        <TextBlock Text="{Binding SelectedAccount.Email}" Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,16"/>
                        <Button Content="Bật / khóa truy cập" Command="{Binding ToggleAccountStatusCommand}" CommandParameter="{Binding SelectedAccount}" Style="{StaticResource BtnDanger}"/>
                        <TextBlock Text="Mật khẩu mới" Margin="0,24,0,8"/>
                        <PasswordBox x:Name="ResetPasswordInput" AutomationProperties.Name="Mật khẩu thay thế cho tài khoản đã chọn" Margin="0,0,0,16"/>
                        <Button Content="Đặt lại mật khẩu" Click="ResetAccountPassword_Click" IsEnabled="{Binding CanAdminister}" Style="{StaticResource BtnSecondary}"/>
                        <TextBlock Text="Mật khẩu chỉ được chuyển khi bạn xác nhận thao tác. Liên hệ thành viên theo quy trình nội bộ để cấp thông tin đăng nhập." Style="{StaticResource TextCaption}" TextWrapping="Wrap" Margin="0,20,0,0"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
