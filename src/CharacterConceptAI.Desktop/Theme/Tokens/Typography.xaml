<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">
    <FontFamily x:Key="FontMain">pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/Fonts/#Be Vietnam Pro, Be Vietnam Pro, Segoe UI, Microsoft YaHei UI</FontFamily>
    <FontFamily x:Key="FontIcons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
    <!-- Live-scalable, large, crisp typography tokens updated by ThemeService.SetFontScale -->
    <sys:Double x:Key="FontSizeCaption">12.5</sys:Double>
    <sys:Double x:Key="FontSizeSmall">13.5</sys:Double>
    <sys:Double x:Key="FontSizeBody">15.5</sys:Double>
    <sys:Double x:Key="FontSizeSubtitle">17.5</sys:Double>
    <sys:Double x:Key="FontSizeSection">20</sys:Double>
    <sys:Double x:Key="FontSizePage">28</sys:Double>
    <sys:Double x:Key="FontSizeHero">34</sys:Double>
    <Style TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>
    <!-- The implicit style inherits foreground so button/selection contrast survives. -->
    <Style x:Key="TextBody" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style x:Key="TextPageTitle" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizePage}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="TextSection" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSection}"/>
        <Setter Property="FontWeight" Value="Bold"/>
    </Style>
    <Style x:Key="TextSecondary" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="TextMuted" TargetType="TextBlock" BasedOn="{StaticResource TextBody}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="Medium"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
    </Style>
    <Style x:Key="TextCaption" TargetType="TextBlock" BasedOn="{StaticResource TextMuted}">
        <Setter Property="FontSize" Value="{DynamicResource FontSizeCaption}"/>
        <Setter Property="FontWeight" Value="Medium"/>
    </Style>
    <Style TargetType="Label">
        <Setter Property="FontFamily" Value="{StaticResource FontMain}"/>
        <Setter Property="FontSize" Value="{DynamicResource FontSizeSmall}"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
        <Setter Property="Padding" Value="0,0,0,6"/>
    </Style>
</ResourceDictionary>
