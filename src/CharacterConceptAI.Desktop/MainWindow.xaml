<?xml version="1.0" encoding="utf-8"?>
<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:components="clr-namespace:CharacterConceptAI.Desktop.Components"
        xmlns:views="clr-namespace:CharacterConceptAI.Desktop.Features.Views"
        x:Class="CharacterConceptAI.Desktop.MainWindow"
        Title="Gula Studio — Xưởng Sáng Tạo Nghệ Thuật AI"
        Icon="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_studio.ico"
        Width="1440" Height="900" MinWidth="1100" MinHeight="700"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="{DynamicResource BrushCanvas}"
        Foreground="{DynamicResource BrushTextPrimary}"
        FontFamily="{DynamicResource FontMain}"
        WindowStartupLocation="CenterScreen"
        SizeChanged="Window_SizeChanged"
        StateChanged="Window_StateChanged"
        PreviewKeyDown="Window_PreviewKeyDown">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34"
                      ResizeBorderThickness="6"
                      GlassFrameThickness="0"
                      CornerRadius="0"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <Style x:Key="NavLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="13,0,0,0"/>
            <Setter Property="FontSize" Value="{DynamicResource FontSizeBody}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="NavVectorIcon" TargetType="Path" BasedOn="{StaticResource LucideIcon}">
            <Setter Property="Width" Value="19"/>
            <Setter Property="Height" Value="19"/>
            <Setter Property="StrokeThickness" Value="1.85"/>
        </Style>

        <!-- Minimal Flat Titlebar Control Button -->
        <Style x:Key="TitleBarCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="MinHeight" Value="34"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource BrushTextMuted}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrushHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource BrushSelected}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Minimal Close Button (Crimson Hover) -->
        <Style x:Key="TitleBarCloseButton" TargetType="Button" BasedOn="{StaticResource TitleBarCaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" Background="{TemplateBinding Background}" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#D92D20"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#B42318"/>
                                <Setter Property="Foreground" Value="#FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Theme-Synced Menu Bar Separator -->
        <Style x:Key="TitleMenuSeparatorStyle" TargetType="Separator">
            <Setter Property="Height" Value="1"/>
            <Setter Property="Margin" Value="8,4,8,4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" SnapsToDevicePixels="True"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Clean Theme-Synced Dropdown Sub-Item -->
        <Style x:Key="TitleSubMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="ItemBg"
                                Background="Transparent"
                                CornerRadius="6"
                                Margin="4,1"
                                Padding="{TemplateBinding Padding}"
                                SnapsToDevicePixels="True">
                            <Grid MinWidth="215">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckMark"
                                           Grid.Column="0"
                                           Text="✓"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource BrushGold}"
                                           VerticalAlignment="Center"
                                           Visibility="Collapsed"/>
                                <ContentPresenter Grid.Column="1"
                                                  ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  Margin="2,0,18,0"/>
                                <TextBlock Grid.Column="2"
                                           Text="{TemplateBinding InputGestureText}"
                                           FontSize="11"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemBg" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushGold}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.40"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Top-Level Menu Bar Item sitting inside the 34px Titlebar -->
        <Style x:Key="TitleTopMenuItemStyle" TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource BrushTextSecondary}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Padding" Value="10,0"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="ItemContainerStyle" Value="{StaticResource TitleSubMenuItemStyle}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid SnapsToDevicePixels="True">
                            <Border x:Name="HeaderBg"
                                    Background="Transparent"
                                    CornerRadius="6"
                                    Padding="{TemplateBinding Padding}">
                                <ContentPresenter ContentSource="Header"
                                                  RecognizesAccessKey="True"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Center"/>
                            </Border>
                            <Popup x:Name="PART_Popup"
                                   AllowsTransparency="True"
                                   Placement="Bottom"
                                   VerticalOffset="4"
                                   IsOpen="{TemplateBinding IsSubmenuOpen}"
                                   Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource BrushCardElevated}"
                                        BorderBrush="{DynamicResource BrushBorderStrong}"
                                        BorderThickness="1"
                                        CornerRadius="10"
                                        Padding="0,5"
                                        Margin="0,0,8,8">
                                    <Border.Effect>
                                        <DropShadowEffect Color="#000000" BlurRadius="18" ShadowDepth="4" Opacity="0.35"/>
                                    </Border.Effect>
                                    <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource BrushHover}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushTextPrimary}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="HeaderBg" Property="Background" Value="{DynamicResource BrushSelected}"/>
                                <Setter Property="Foreground" Value="{DynamicResource BrushGold}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootWindowHost" Background="{DynamicResource BrushCanvas}">
        <Grid.RowDefinitions>
            <RowDefinition x:Name="TitleBarRow" Height="34"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ULTRA-MINIMAL TITLEBAR: Top-Left Menu Bar (File / Edit / View / Help) + Right Theme & Window Controls -->
        <Border x:Name="TitleBarChrome"
                Grid.Row="0"
                Background="{DynamicResource BrushShell}"
                BorderBrush="{DynamicResource BrushBorderSubtle}"
                BorderThickness="0,0,0,1"
                SnapsToDevicePixels="True">
            <Grid>
                <!-- Top-Left Menu Bar (Default English: File · Edit · View · Help) -->
                <Menu HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      Background="Transparent"
                      BorderThickness="0"
                      Margin="8,0,0,0"
                      WindowChrome.IsHitTestVisibleInChrome="True">
                    <MenuItem Header="File" Style="{StaticResource TitleTopMenuItemStyle}" AutomationProperties.Name="File Menu">
                        <MenuItem Header="New Chat" InputGestureText="Ctrl+N" Command="{Binding NewChatCommand}"/>
                        <MenuItem Header="Story Studio" Command="{Binding SetTabCommand}" CommandParameter="12"/>
                        <MenuItem Header="Open Output Folder" Command="{Binding OpenAutoExportFolderCommand}"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Setup &amp; Model Manager..." Command="{Binding OpenSetupManagerCommand}"/>
                        <MenuItem Header="Preferences" InputGestureText="Ctrl+," Click="MenuEditPreferences_Click"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="CloseWindow_Click"/>
                    </MenuItem>

                    <MenuItem Header="Edit" Style="{StaticResource TitleTopMenuItemStyle}" AutomationProperties.Name="Edit Menu">
                        <MenuItem Header="Undo" InputGestureText="Ctrl+Z" Click="MenuEditUndo_Click"/>
                        <MenuItem Header="Redo" InputGestureText="Ctrl+Y" Click="MenuEditRedo_Click"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X" Click="MenuEditCut_Click"/>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C" Click="MenuEditCopy_Click"/>
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V" Click="MenuEditPaste_Click"/>
                        <MenuItem Header="Select All" InputGestureText="Ctrl+A" Click="MenuEditSelectAll_Click"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Preferences" InputGestureText="Ctrl+," Click="MenuEditPreferences_Click"/>
                    </MenuItem>

                    <MenuItem Header="View" Style="{StaticResource TitleTopMenuItemStyle}" AutomationProperties.Name="View Menu">
                        <MenuItem Header="Zoom In" InputGestureText="Ctrl++" Click="MenuViewZoomIn_Click"/>
                        <MenuItem Header="Zoom Out" InputGestureText="Ctrl+-" Click="MenuViewZoomOut_Click"/>
                        <MenuItem Header="Reset Zoom (100%)" InputGestureText="Ctrl+0" Click="MenuViewZoomReset_Click"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem x:Name="MenuFullScreenItem" Header="Full Screen" InputGestureText="F11" IsCheckable="True" Click="MenuViewFullScreen_Click"/>
                        <MenuItem Header="Toggle Sidebar" InputGestureText="Ctrl+B" Click="ToggleSidebar_Click"/>
                        <MenuItem Header="Toggle Light / Dark Theme" Command="{Binding ToggleThemeCommand}"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Language · Tiếng Việt" IsCheckable="True" IsChecked="{Binding IsLanguageVi, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="vi"/>
                        <MenuItem Header="Language · English" IsCheckable="True" IsChecked="{Binding IsLanguageEn, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="en"/>
                        <MenuItem Header="Language · 中文 (简体)" IsCheckable="True" IsChecked="{Binding IsLanguageZh, Mode=OneWay}" Command="{Binding SetLanguageCommand}" CommandParameter="zh"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Snap Window Left" Click="MenuWindowSnapLeft_Click"/>
                        <MenuItem Header="Snap Window Right" Click="MenuWindowSnapRight_Click"/>
                        <MenuItem Header="Center Window (1440×900)" Click="MenuWindowCenterDefault_Click"/>
                        <MenuItem x:Name="MenuTopmostItem" Header="Always on Top" IsCheckable="True" Click="MenuWindowTopmost_Click"/>
                    </MenuItem>

                    <MenuItem Header="Help" Style="{StaticResource TitleTopMenuItemStyle}" AutomationProperties.Name="Help Menu">
                        <MenuItem Header="Setup &amp; Model Manager..." Command="{Binding OpenSetupManagerCommand}"/>
                        <MenuItem Header="User Guide" Click="MenuHelpGuide_Click"/>
                        <MenuItem Header="Keyboard Shortcuts" InputGestureText="F1" Click="MenuHelpShortcuts_Click"/>
                        <Separator Style="{StaticResource TitleMenuSeparatorStyle}"/>
                        <MenuItem Header="Check for Updates" Click="MenuHelpCheckUpdate_Click"/>
                        <MenuItem Header="About Gula Studio" Click="MenuHelpAbout_Click"/>
                    </MenuItem>
                </Menu>

                <!-- Top-Right Language Switcher + Theme Toggle + Window Controls -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}" VerticalAlignment="Stretch"/>
                    <Button Command="{Binding CycleLanguageCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            Width="46"
                            ToolTip="{Binding CurrentLanguageDisplayLabel}"
                            AutomationProperties.Name="Chuyển đổi ngôn ngữ Việt Anh Trung">
                        <TextBlock Text="{Binding CurrentLanguageShortBadge}"
                                   FontSize="11.5"
                                   FontWeight="Bold"
                                   Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Button>
                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}" VerticalAlignment="Stretch"/>
                    <Button Command="{Binding ToggleThemeCommand}"
                            Style="{StaticResource TitleBarCaptionButton}"
                            ToolTip="{Binding ThemeLabel}"
                            AutomationProperties.Name="Chuyển giao diện sáng tối">
                        <Grid Width="14" Height="14">
                            <Path Data="{StaticResource Icon.Sun}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding IsDarkTheme, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                            <Path Data="{StaticResource Icon.Moon}" Width="14" Height="14" Stretch="Uniform"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="{Binding IsDarkTheme, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                        </Grid>
                    </Button>
                    <Border Width="1" Background="{DynamicResource BrushBorderSubtle}" VerticalAlignment="Stretch"/>
                    <Button Click="MinimizeWindow_Click"
                            Style="{StaticResource TitleBarCaptionButton}"
                            ToolTip="Thu nhỏ"
                            AutomationProperties.Name="Thu nhỏ cửa sổ">
                        <Path Data="M 0,5 L 10,5" Width="10" Height="10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.25" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                    <Button Click="MaximizeRestoreWindow_Click"
                            Style="{StaticResource TitleBarCaptionButton}"
                            ToolTip="Phóng to / Khôi phục"
                            AutomationProperties.Name="Phóng to hoặc khôi phục cửa sổ">
                        <Grid Width="10" Height="10">
                            <Path x:Name="MaximizeGlyph"
                                  Data="M 0.6,0.6 L 9.4,0.6 L 9.4,9.4 L 0.6,9.4 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.2" StrokeLineJoin="Round"/>
                            <Path x:Name="RestoreGlyph"
                                  Visibility="Collapsed"
                                  Data="M 2.3,2.3 L 2.3,0.6 L 9.4,0.6 L 9.4,7.7 L 7.7,7.7 M 0.6,2.3 L 7.7,2.3 L 7.7,9.4 L 0.6,9.4 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                  StrokeThickness="1.15" StrokeLineJoin="Round"/>
                        </Grid>
                    </Button>
                    <Button Click="CloseWindow_Click"
                            Style="{StaticResource TitleBarCloseButton}"
                            ToolTip="Đóng ứng dụng"
                            AutomationProperties.Name="Đóng cửa sổ">
                        <Path Data="M 1,1 L 9,9 M 9,1 L 1,9" Width="10" Height="10" Stretch="None"
                              Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                              StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid x:Name="WorkspaceZoomHost" Grid.Row="1">
            <Grid.LayoutTransform>
                <ScaleTransform x:Name="WorkspaceZoomTransform" ScaleX="1" ScaleY="1"/>
            </Grid.LayoutTransform>
        <!-- MAIN WORKSPACE: Full-Height Minimalist Sidebar + Expansive Chromeless Canvas -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="256"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- LEFT SIDEBAR (Minimalist Navigation Rail) -->
            <Border x:Name="SidebarBorder" Grid.Column="0" Background="{DynamicResource BrushShell}" BorderBrush="{DynamicResource BrushBorderSubtle}" BorderThickness="0,0,1,0" Padding="14,18,14,14">
                <DockPanel>
                    <!-- Bottom: Pinned Settings + Connection Micro-Status -->
                    <StackPanel DockPanel.Dock="Bottom">
                        <Border Height="1" Background="{DynamicResource BrushBorderSubtle}" Margin="4,10,4,10"/>
                        <Button Command="{Binding SetTabCommand}" CommandParameter="5" Style="{StaticResource BtnSidebarNav}" Tag="{Binding CurrentTabIndex, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=5}" ToolTip="{DynamicResource Str.Nav.Settings}" AutomationProperties.Name="Cài đặt">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Settings}" Style="{StaticResource NavVectorIcon}"/>
                                <TextBlock Text="{DynamicResource Str.Nav.Settings}" Tag="NavLabel" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Top: Brand Mark + Sidebar Toggle Right Next to Logo + Primary Nav + Pill CTA -->
                    <StackPanel DockPanel.Dock="Top">
                        <!-- Minimalist Brand Emblem + Collapse Toggle on its Right -->
                        <Grid Margin="6,2,0,20">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Left">
                                <Border Background="#000000" BorderBrush="{DynamicResource BrushEmerald}" BorderThickness="1.2" CornerRadius="10" Width="34" Height="34" Padding="2">
                                    <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Border>
                                <StackPanel Tag="NavLabel" Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                                    <TextBlock Text="Gula" Tag="NavLabel" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="Studio" Tag="NavLabel" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource BrushGold}" Margin="4,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                            </StackPanel>
                            <Button x:Name="SidebarCollapseButton"
                                    Click="ToggleSidebar_Click"
                                    Style="{StaticResource BtnIcon}"
                                    Width="32" Height="32" MinHeight="32"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    ToolTip="Đóng thanh bên để mở rộng không gian"
                                    AutomationProperties.Name="Đóng thanh bên">
                                <Path Data="{StaticResource Icon.PanelLeftClose}" Style="{StaticResource LucideIcon}"/>
                            </Button>
                        </Grid>

                        <!-- Clean Borderless Navigation Items -->
                        <Button Command="{Binding SetTabCommand}" CommandParameter="0" Style="{StaticResource BtnSidebarNav}" Tag="{Binding IsStudioChatTabSelected, Converter={StaticResource BoolToSelectedTagConverter}}" ToolTip="{DynamicResource Str.Nav.AiStudio}" AutomationProperties.Name="Studio AI">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Sparkles}" Style="{StaticResource NavVectorIcon}"/>
                                <TextBlock Text="{DynamicResource Str.Nav.AiStudio}" Tag="NavLabel" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetTabCommand}" CommandParameter="12" Style="{StaticResource BtnSidebarNav}" Tag="{Binding CurrentTabIndex, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=12}" ToolTip="{DynamicResource Str.Story.Subtitle}" AutomationProperties.Name="Câu chuyện nhiều cảnh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.BookOpen}" Style="{StaticResource NavVectorIcon}"/>
                                <TextBlock Text="{DynamicResource Str.Nav.Storyboard}" Tag="NavLabel" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding ToggleFavoritesModeCommand}" Style="{StaticResource BtnSidebarNav}" Tag="{Binding IsFavoritesTabSelected, Converter={StaticResource BoolToSelectedTagConverter}}" ToolTip="{DynamicResource Str.Nav.Favorites}" AutomationProperties.Name="Ảnh yêu thích">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Star}" Style="{StaticResource NavVectorIcon}"/>
                                <TextBlock Text="{Binding FavoritesCountLabel}" Tag="NavLabel" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SetTabCommand}" CommandParameter="7" Style="{StaticResource BtnSidebarNav}" Tag="{Binding CurrentTabIndex, Converter={StaticResource IntToSelectedTagConverter}, ConverterParameter=7}" ToolTip="{DynamicResource Str.Nav.GpuQueue}" AutomationProperties.Name="Tác vụ sinh ảnh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.Cpu}" Style="{StaticResource NavVectorIcon}"/>
                                <TextBlock Text="{DynamicResource Str.Nav.GpuQueue}" Tag="NavLabel" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding OpenAutoExportFolderCommand}" Style="{StaticResource BtnSidebarNav}" ToolTip="{DynamicResource Str.Nav.OutputFolder}" AutomationProperties.Name="Mở thư mục ảnh">
                            <StackPanel Orientation="Horizontal">
                                <Path Data="{StaticResource Icon.FolderOpen}" Style="{StaticResource NavVectorIcon}"/>
                                <TextBlock Text="{DynamicResource Str.Nav.OutputFolder}" Tag="NavLabel" Style="{StaticResource NavLabel}"/>
                            </StackPanel>
                        </Button>

                        <!-- Single Commanding Pill CTA (#B2CB25 Volt Lime with Pure Black #000000 text/icon) -->
                        <Button x:Name="NewChatButton"
                                Command="{Binding NewChatCommand}"
                                Style="{StaticResource BtnPrimary}"
                                Height="42"
                                Margin="2,14,2,18"
                                Padding="16,0"
                                ToolTip="Ctrl+N"
                                AutomationProperties.Name="Cuộc trò chuyện mới">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Data="{StaticResource Icon.Plus}" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource BrushOnEmerald}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <TextBlock Text="{DynamicResource Str.Nav.NewChat}" Tag="NavLabel" Margin="8,0,0,0" FontSize="{DynamicResource FontSizeBody}" FontWeight="Bold" Foreground="{DynamicResource BrushOnEmerald}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- Calm Quiet Chat History -->
                    <DockPanel x:Name="ChatHistorySection">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                            <TextBlock Text="{DynamicResource Str.Nav.Recent}" Tag="NavLabel" Style="{StaticResource TextCaption}" FontWeight="Bold" Foreground="{DynamicResource BrushTextSecondary}" Margin="10,0,0,8"/>
                            <Grid Margin="2,0">
                                <TextBox x:Name="ChatSearchInput"
                                         Text="{Binding ChatSearchText, UpdateSourceTrigger=PropertyChanged}"
                                         MinHeight="34"
                                         FontSize="{DynamicResource FontSizeSmall}"
                                         Padding="28,4,10,4"
                                         Background="{DynamicResource BrushCard}"
                                         BorderBrush="{DynamicResource BrushBorderSubtle}"
                                         AutomationProperties.Name="Tìm kiếm lịch sử trò chuyện"/>
                                <Path Data="{StaticResource Icon.Search}" Width="14" Height="14" Stretch="Uniform" Stroke="{DynamicResource BrushTextSecondary}" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0,0,0" IsHitTestVisible="False"/>
                                <TextBlock Text="{DynamicResource Str.Nav.SearchHistory}"
                                           Foreground="{DynamicResource BrushTextMuted}"
                                           FontSize="{DynamicResource FontSizeSmall}"
                                           FontWeight="Medium"
                                           Margin="29,0,0,0"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=ChatSearchInput}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </StackPanel>
                        <Grid>
                            <TextBlock Text="{DynamicResource Str.Nav.NoHistory}"
                                       Style="{StaticResource TextCaption}"
                                       TextWrapping="Wrap"
                                       Margin="10,6,8,0"
                                       Visibility="{Binding HasChatHistory, Converter={StaticResource InverseBooleanToVisibilityConverter}}"/>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Visibility="{Binding HasChatHistory, Converter={StaticResource BooleanToVisibilityConverter}}">
                                <ItemsControl ItemsSource="{Binding FilteredChatThreads}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="10" Margin="0,0,0,3">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="Transparent"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="Background" Value="{DynamicResource BrushSelected}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Button Command="{Binding DataContext.SelectChatThreadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BtnGhost}"
                                                            HorizontalContentAlignment="Left"
                                                            Padding="10,7"
                                                            MinHeight="38"
                                                            ToolTip="{Binding Title}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="{DynamicResource FontSizeSmall}" FontWeight="SemiBold" Foreground="{DynamicResource BrushTextPrimary}" TextTrimming="CharacterEllipsis"/>
                                                            <TextBlock Text="{Binding Subtitle}" FontSize="{DynamicResource FontSizeCaption}" FontWeight="Medium" Foreground="{DynamicResource BrushTextMuted}" Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding DataContext.DeleteChatThreadCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource BtnCloseIconCompact}"
                                                            VerticalAlignment="Center"
                                                            Margin="0,0,4,0"
                                                            ToolTip="Xóa cuộc trò chuyện này"
                                                            AutomationProperties.Name="Xóa cuộc trò chuyện"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Grid>
                    </DockPanel>
                </DockPanel>
            </Border>

            <!-- RIGHT CANVAS: Expansive Chromeless Space with Whisper-Minimal Floating Top Bar -->
            <Grid Grid.Column="1" Background="{DynamicResource BrushCanvas}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Floating Minimal Top Utility Bar -->
                <Grid Grid.Row="0" Margin="20,12,20,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left: Optional Mini-Logo + Reopen Sidebar Toggle (when collapsed/compact) + Context Header -->
                    <Grid Grid.Column="0" VerticalAlignment="Center" Margin="0,0,12,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel x:Name="CollapsedSidebarHeader" Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Visibility="Collapsed" Margin="0,0,12,0">
                            <Border x:Name="CollapsedMiniLogo" Background="#000000" BorderBrush="{DynamicResource BrushEmerald}" BorderThickness="1.2" CornerRadius="9" Width="30" Height="30" Padding="2" Margin="0,0,8,0">
                                <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <Button x:Name="SidebarExpandButton"
                                    Click="ToggleSidebar_Click"
                                    Style="{StaticResource BtnIcon}"
                                    Width="32" Height="32" MinHeight="32"
                                    ToolTip="Mở / đóng thanh bên"
                                    AutomationProperties.Name="Mở thanh bên">
                                <Path Data="{StaticResource Icon.PanelLeftOpen}" Style="{StaticResource LucideIcon}"/>
                            </Button>
                            <Border Width="1" Height="18" Background="{DynamicResource BrushBorderStrong}" Margin="10,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1"
                                   Text="{Binding ActiveChatTitle}"
                                   Foreground="{DynamicResource BrushTextPrimary}"
                                   FontSize="{DynamicResource FontSizeSmall}"
                                   FontWeight="Bold"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="420"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding ActiveChatTitle}"/>
                        <TextBlock Grid.Column="2" Text="·" Foreground="{DynamicResource BrushTextMuted}" Margin="10,0" VerticalAlignment="Center"
                                   Visibility="{Binding StatusMessage, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                        <TextBlock Grid.Column="3"
                                   Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource BrushTextSecondary}"
                                   FontSize="{DynamicResource FontSizeCaption}"
                                   FontWeight="Medium"
                                   TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   ToolTip="{Binding StatusMessage}"
                                   AutomationProperties.LiveSetting="Polite"/>
                    </Grid>

                    <!-- Theme toggle moved into the top minimal titlebar -->
                </Grid>

                <!-- Main View Content -->
                <Grid Grid.Row="1" Margin="18,4,18,14">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <Border Background="{DynamicResource BrushSelected}" CornerRadius="10" Padding="12,8" Margin="0,0,0,12" Visibility="{Binding IsProjectArchived, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <TextBlock Text="Dự án đã được lưu trữ. Nội dung được giữ lại để xem; thao tác chỉnh sửa bị hạn chế." TextWrapping="Wrap" Foreground="{DynamicResource BrushWarning}"/>
                        </Border>
                        <Border Style="{StaticResource InlineBanner}" BorderBrush="{DynamicResource BrushGoldSubtle}" Margin="0,0,0,12" Visibility="{Binding EditorError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding EditorError}" TextWrapping="Wrap" Foreground="{DynamicResource BrushNegative}" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive"/>
                                <Button Grid.Column="1" Command="{Binding DismissErrorCommand}" Style="{StaticResource BtnCloseIcon}" Margin="16,0,0,0" ToolTip="Đóng thông báo" AutomationProperties.Name="Đóng thông báo"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <views:OverviewView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=11}"/>
                        <views:ProjectsView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=6}"/>
                        <views:RecentsView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=10}"/>
                        <views:CharactersView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=1}"/>
                        <views:ConceptsView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=2}"/>
                        <views:StudioView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=0}"/>
                        <views:ScriptsView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=3}"/>
                        <views:ProjectTeamView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=4}"/>
                        <views:JobsView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=7}"/>
                        <views:SettingsView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=5}"/>
                        <views:ComponentGalleryView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=8}"/>
                        <views:AdminView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=9}"/>
                        <views:StoryStudioView Visibility="{Binding CurrentTabIndex, Converter={StaticResource IntToVisibilityConverter}, ConverterParameter=12}"/>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>

        <!-- RECONNECT / STARTUP SCREEN -->
        <Grid Visibility="{Binding IsLoggedIn, Converter={StaticResource InverseBooleanToVisibilityConverter}}" Background="{DynamicResource BrushCanvas}">
            <Border Background="{DynamicResource BrushHeroAura}" IsHitTestVisible="False"/>
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="32">
                <Border Background="#000000" BorderBrush="{DynamicResource BrushEmerald}" BorderThickness="1.8" CornerRadius="22" Width="78" Height="78" Padding="6" HorizontalAlignment="Center" Margin="0,0,0,18">
                    <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="Gula Studio" FontSize="{DynamicResource FontSizePage}" FontWeight="Bold" Foreground="{DynamicResource BrushDreaminaHero}" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding StatusMessage}" Style="{StaticResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,10,0,0" AutomationProperties.LiveSetting="Polite"/>
                <Button Command="{Binding ReconnectLocalStudioCommand}"
                        Style="{StaticResource BtnPrimary}"
                        Height="44"
                        Padding="24,0"
                        Margin="0,24,0,0"
                        HorizontalAlignment="Center"
                        Visibility="{Binding ShowLocalReconnectButton, Converter={StaticResource BooleanToVisibilityConverter}}"
                        AutomationProperties.Name="Kết nối lại máy chủ AI cục bộ">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Path Data="{StaticResource Icon.RefreshCw}" Style="{StaticResource LucideIconSmall}" Stroke="{DynamicResource BrushOnEmerald}" Margin="0,0,8,0"/>
                        <TextBlock Text="{DynamicResource Str.Reconnect.Button}" Foreground="{DynamicResource BrushOnEmerald}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding OpenSetupManagerCommand}"
                        Style="{StaticResource BtnSecondary}"
                        Height="40"
                        Padding="22,0"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        ToolTip="1-Click Setup &amp; Model Manager"
                        AutomationProperties.Name="Tải và cài đặt mô hình AI">
                    <TextBlock Text="{DynamicResource Str.Reconnect.SetupButton}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- MODALS -->
        <Grid Visibility="{Binding IsCreateProjectDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}" Background="{DynamicResource BrushOverlay}" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Style="{StaticResource Card}" Width="560" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center" MaxHeight="620">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="{Binding ProjectEditorTitle, FallbackValue='Tạo dự án'}" Style="{StaticResource TextSection}" VerticalAlignment="Center"/>
                            <Button Command="{Binding CloseCreateProjectDialogCommand}" Style="{StaticResource BtnCloseIcon}" HorizontalAlignment="Right" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng"/>
                        </Grid>
                        <TextBlock Text="Tập hợp nhân vật, kịch bản và concept trong cùng một không gian." Style="{StaticResource TextSecondary}" TextWrapping="Wrap" Margin="0,8,0,24"/>
                        <Label Content="Tên dự án *" Target="{Binding ElementName=ProjectNameInput}" Padding="0,0,0,8"/>
                        <TextBox x:Name="ProjectNameInput" Text="{Binding QuickProjectName, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" Margin="0,0,0,16" AutomationProperties.Name="Tên dự án bắt buộc"/>
                        <TextBlock Text="Loại dự án" Margin="0,0,0,8"/>
                        <ComboBox ItemsSource="{Binding AvailableProjectTypes}" SelectedItem="{Binding QuickProjectType}" Margin="0,0,0,16" AutomationProperties.Name="Loại dự án"/>
                        <TextBlock Text="Mô tả" Margin="0,0,0,8"/>
                        <TextBox Text="{Binding QuickProjectDescription, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" Height="96" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" AutomationProperties.Name="Mô tả dự án"/>
                        <TextBlock Text="{Binding EditorError}" Foreground="{DynamicResource BrushNegative}" TextWrapping="Wrap" Margin="0,16,0,0" FontSize="12"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
                            <Button Content="Hủy" Command="{Binding CloseCreateProjectDialogCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" MinWidth="80"/>
                            <Button Content="Lưu dự án" Command="{Binding SubmitQuickCreateProjectCommand}" Style="{StaticResource BtnPrimary}" MinWidth="120"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
        <Grid Visibility="{Binding IsCreateCharacterDialogOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              Background="{DynamicResource BrushOverlay}" KeyboardNavigation.TabNavigation="Cycle"
              KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Border Style="{StaticResource Card}" Width="560" Padding="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="Tạo nhân vật" Style="{StaticResource TextSection}" VerticalAlignment="Center"/>
                        <Button Command="{Binding CloseCreateCharacterDialogCommand}" Style="{StaticResource BtnCloseIcon}" HorizontalAlignment="Right" ToolTip="Đóng (Esc)" AutomationProperties.Name="Đóng"/>
                    </Grid>
                    <TextBlock Text="{Binding SelectedProject.Name}" Style="{StaticResource TextSecondary}" Margin="0,6,0,22"/>
                    <Label Content="Tên nhân vật *" Target="{Binding ElementName=CharacterNameInput}" Padding="0,0,0,8"/>
                    <TextBox x:Name="CharacterNameInput" Text="{Binding NewCharacterName, UpdateSourceTrigger=PropertyChanged}"
                             MaxLength="100" Margin="0,0,0,16" AutomationProperties.Name="Tên nhân vật mới"/>
                    <Label Content="Mô tả ngoại hình (không bắt buộc)" Target="{Binding ElementName=CharacterDescriptionInput}" Padding="0,0,0,8"/>
                    <TextBox x:Name="CharacterDescriptionInput" Text="{Binding NewCharacterDescription, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="96" MaxLength="5000" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>
                    <Expander Header="Đổi vai trò (mặc định: nhân vật chính)" Margin="0,16,0,0">
                        <ComboBox ItemsSource="{Binding AvailableCharacterRoles}" SelectedItem="{Binding NewCharacterRole}"
                                  Margin="0,8,0,0" AutomationProperties.Name="Vai trò nhân vật mới"/>
                    </Expander>
                    <TextBlock Text="{Binding CharacterCreateError}" Foreground="{DynamicResource BrushNegative}"
                               TextWrapping="Wrap" Margin="0,12,0,0" AutomationProperties.LiveSetting="Assertive"
                               Visibility="{Binding CharacterCreateError, Converter={StaticResource StringNotEmptyToVisibilityConverter}}"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                        <Button Content="Hủy" Command="{Binding CloseCreateCharacterDialogCommand}" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0"/>
                        <Button Content="Tạo nhân vật" Command="{Binding CreateCharacterCommand}" Style="{StaticResource BtnPrimary}"
                                IsDefault="{Binding IsCreateCharacterDialogOpen}" AutomationProperties.Name="Lưu nhân vật mới"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
        <views:PoseGalleryOverlay Panel.ZIndex="40"/>
        <views:OutfitGalleryOverlay Panel.ZIndex="41"/>

        <!-- Full-Featured One-Click Setup & Model Manager Modal Overlay (works even before Server/ComfyUI starts!) -->
        <Grid x:Name="SetupManagerOverlay"
              Panel.ZIndex="58"
              Background="{DynamicResource BrushOverlay}"
              Visibility="{Binding IsSetupModalOpen, Converter={StaticResource BooleanToVisibilityConverter}}"
              MouseLeftButtonDown="SetupModalBackdrop_MouseDown">
            <Border Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    Width="920"
                    MaxWidth="960"
                    MaxHeight="780"
                    Margin="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="HelpModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#000000" BorderBrush="{DynamicResource BrushEmerald}" BorderThickness="1.2" Padding="2" Margin="0,0,10,0">
                                <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock Text="{DynamicResource Str.Setup.ModalTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource BrushTextPrimary}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Command="{Binding CloseSetupManagerCommand}"
                                Style="{StaticResource BtnCloseIcon}"
                                HorizontalAlignment="Right"
                                ToolTip="Đóng (Esc)"
                                AutomationProperties.Name="Đóng trình cài đặt mô hình"/>
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="0,0,8,0">
                        <views:SetupManagerView/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- In-App Help / Shortcuts / About / Update Modal Overlay -->
        <Grid x:Name="HelpModalOverlay"
              Panel.ZIndex="60"
              Background="{DynamicResource BrushOverlay}"
              Visibility="Collapsed"
              MouseLeftButtonDown="HelpModalBackdrop_MouseDown">
            <Border Background="{DynamicResource BrushCard}"
                    BorderBrush="{DynamicResource BrushBorderStrong}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="24"
                    Width="500"
                    MaxHeight="600"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    MouseLeftButtonDown="HelpModalCard_MouseDown">
                <Border.Effect>
                    <DropShadowEffect Color="#000000" BlurRadius="28" ShadowDepth="8" Opacity="0.45"/>
                </Border.Effect>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="28" Height="28" CornerRadius="8" Background="#000000" BorderBrush="{DynamicResource BrushEmerald}" BorderThickness="1.2" Padding="2" Margin="0,0,10,0">
                                <Image Source="pack://application:,,,/CharacterConceptAI.Desktop;component/Assets/gula_logo.png" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                            <TextBlock x:Name="HelpModalTitle"
                                       Text="Thông tin Gula Studio"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource BrushTextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button Click="CloseHelpModal_Click"
                                Style="{StaticResource BtnCloseIcon}"
                                HorizontalAlignment="Right"
                                ToolTip="Đóng (Esc)"
                                AutomationProperties.Name="Đóng hộp thoại trợ giúp"/>
                    </Grid>

                    <Grid DockPanel.Dock="Bottom" Margin="0,18,0,0">
                        <StackPanel x:Name="AboutActionLinks" Orientation="Horizontal" HorizontalAlignment="Left" Visibility="Collapsed">
                            <Button Content="GitHub" Click="OpenAuthorGitHub_Click" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" ToolTip="https://github.com/KhoaLe7722"/>
                            <Button Content="X" Click="OpenAuthorX_Click" Style="{StaticResource BtnSecondary}" Margin="0,0,8,0" ToolTip="https://x.com/KhoaLe7722"/>
                            <Button Content="Gmail" Click="OpenAuthorGmail_Click" Style="{StaticResource BtnSecondary}" ToolTip="leanhkhoa7722@gmail.com"/>
                        </StackPanel>
                        <Button Content="{DynamicResource Str.Common.Close}" Click="CloseHelpModal_Click" Style="{StaticResource BtnPrimary}" MinWidth="92" HorizontalAlignment="Right"/>
                    </Grid>

                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="HelpModalBody"
                                   TextWrapping="Wrap"
                                   LineHeight="22"
                                   FontSize="13"
                                   Foreground="{DynamicResource BrushTextSecondary}"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
        </Grid>
    </Grid>
</Window>
